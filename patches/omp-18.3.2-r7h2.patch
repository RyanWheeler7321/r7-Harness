+		this.#releaseTitleOwnership(source === "revision" ? "revision-rebased" : "opening-replaced", false);
+		const remainingMinutes = directive.suit === "✦" ? undefined : directive.minutes;
+		const displayMinutes =
+			remainingMinutes === undefined
+				? undefined
+				: source === "revision"
+					? Math.max(1, Math.round((at + remainingMinutes * 60_000 - contextSince) / 60_000))
+					: remainingMinutes;
+		const dueAt =
+			remainingMinutes === undefined ? undefined : at + remainingMinutes * 60_000 + OVERDUE_TITLE_GRACE_MS;
+		const state: TitleOwnershipState = {
+			sessionId,
+			generation,
+			suit: directive.suit,
+			body: directive.title,
+			title: this.#formatTaskTitle(directive.suit, directive.title, displayMinutes),
+			taskStartedAt: contextSince,
+			latestAssistantAt: at,
+			dueAt,
+			phase: remainingMinutes === undefined ? "untimed" : "timed",
+			progressToolResultSequence: this.#syncTitleToolResultSequence(),
+			reassessmentAttempts: 0,
+			reassessmentCalls,
+			waitingForProgress: false,
+		};
+		this.#titleOwnership = state;
+		this.#commitTitleOwnership(state, source);
+		if (dueAt !== undefined) this.#armTitleOwnershipDeadline(state);
+		if (source === "fallback") {
+			logger.warn("title-ownership: fallback", {
+				...this.#titleOwnershipLogFields(state, source),
+				firstLine: fallback?.firstLine ?? "",
+				reason: fallback?.reason ?? "malformed-opening",
+			});
+		} else {
+			logger.info(`title-ownership: ${source}`, this.#titleOwnershipLogFields(state, source));
+		}
+	}
+
+	#startR7TitleOwnershipAfterOpening(assistantText: string, assistantTimestamp: number): void {
+		const pending = this.#postOpeningTitleGeneration;
+		if (pending) {
+			if (assistantTimestamp < pending.requestedAt) return;
+			if (!assistantText.trim()) return;
+			this.#postOpeningTitleGeneration = undefined;
+			if (!this.#isTitleTurnCurrent(pending.sessionId, pending.turnGeneration)) return;
+			const directive = parseTaskTitleDirective(assistantText);
+			if (directive) {
+				if (directive.minutesDefaulted) {
+					logger.warn("title-ownership: minutes-defaulted", {
+						sessionId: pending.sessionId,
+						firstLine: this.#boundedTitleOpeningLine(assistantText),
+					});
+				}
+				this.#applyR7TitleOwnership(
+					directive,
+					"opening",
+					pending.sessionId,
+					pending.turnGeneration,
+					assistantTimestamp,
+					pending.requestedAt,
+				);
+				return;
+			}
+			// A reply with no suit continues the current task (steers, follow-up
+			// answers), so an existing title stays. A suit always announces a new
+			// task, so one that can't be read still replaces the old title.
+			const currentTitle = this.sessionManager.getSessionName()?.trim();
+			if (currentTitle && !startsWithTaskTitleSuit(assistantText)) {
