+/** Status chip moved off an overflowing composer bar, aligned to the bar's right edge. */
+export interface RelocatedStatusChip {
+	readonly content: string;
+	readonly width: number;
+	/** Columns between the chip's right edge and the row's right edge (the box border chrome). */
+	readonly rightInset: number;
+}
