diff --git a/packages/coding-agent/test/tool-image-cache.test.ts b/packages/coding-agent/test/tool-image-cache.test.ts
new file mode 100644
index 0000000000..273a30472a
--- /dev/null
+++ b/packages/coding-agent/test/tool-image-cache.test.ts
@@ -0,0 +1,203 @@
+import { afterEach, beforeEach, describe, expect, it } from "bun:test";
+import type { AgentMessage } from "@oh-my-pi/pi-agent-core";
+import type { Model } from "@oh-my-pi/pi-ai";
+import type { SessionManager } from "@oh-my-pi/pi-coding-agent/session/session-manager";
+import {
+	ToolResultImageCache,
+	normalizeToolResultImagesForProvider,
+} from "@oh-my-pi/pi-coding-agent/session/session-provider-boundary";
+
+const RED_1X1_PNG_BASE64 =
+	"iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAIAAACQd1PeAAAADElEQVR4nGP4z8AAAAMBAQDJ/pLvAAAAAElFTkSuQmCC";
+
+type ToolImageStore = Pick<SessionManager, "putBlob" | "resolveBlobImageData">;
+
+type TestStore = {
+	store: ToolImageStore;
+	blobs: Map<string, string>;
+	putCount(): number;
+};
+
+function createTestStore(): TestStore {
+	const blobs = new Map<string, string>();
+	let puts = 0;
+	const store = {
+		async putBlob(data: Buffer) {
+			puts++;
+			const hash = new Bun.CryptoHasher("sha256").update(data).digest("hex");
+			const ref = `blob:sha256:${hash}`;
+			blobs.set(ref, data.toString("base64"));
+			return { ref };
+		},
+		async resolveBlobImageData(ref: string) {
+			return blobs.get(ref) ?? null;
+		},
+	} as unknown as ToolImageStore;
+	return { store, blobs, putCount: () => puts };
+}
+
+async function putSource(store: ToolImageStore, data: string): Promise<string> {
+	return (await store.putBlob(Buffer.from(data, "base64"))).ref;
+}
+
+async function makePng(width: number): Promise<string> {
+	const bytes = await new Bun.Image(Buffer.from(RED_1X1_PNG_BASE64, "base64"))
+		.resize(width, 200, { filter: "nearest" })
+		.png()
+		.bytes();
+	return Buffer.from(bytes).toString("base64");
+}
+
+async function makeWebP(): Promise<string> {
+	const bytes = await new Bun.Image(Buffer.from(RED_1X1_PNG_BASE64, "base64"))
+		.resize(240, 240, { filter: "nearest" })
+		.webp({ quality: 90 })
+		.bytes();
+	return Buffer.from(bytes).toString("base64");
+}
+
+function toolMessages(refs: readonly string[], mimeType = "image/png"): AgentMessage[] {
+	return refs.map((ref, index) => ({
+		role: "toolResult",
+		toolCallId: `image-${index}`,
+		toolName: "read",
+		content: [{ type: "image", data: ref, mimeType }],
+		isError: false,
+		timestamp: index,
+	}));
+}
+
+function imageAt(messages: AgentMessage[], index = 0) {
+	const message = messages[index];
+	if (!message || message.role !== "toolResult") throw new Error("Expected tool result");
+	const image = message.content[0];
+	if (!image || image.type !== "image") throw new Error("Expected image content");
+	return image;
+}
+
+const webpCapableModel = { provider: "managed-primary", api: "openai-completions" } as Model;
+const stbModel = { ...webpCapableModel, imageInputDecoder: "stb" } as Model;
+const originalNoWebp = Bun.env.OMP_NO_WEBP;
+
+describe("tool-result image blob cache", () => {
+	beforeEach(() => {
+		delete Bun.env.OMP_NO_WEBP;
+	});
+
+	afterEach(() => {
+		if (originalNoWebp === undefined) delete Bun.env.OMP_NO_WEBP;
+		else Bun.env.OMP_NO_WEBP = originalNoWebp;
+	});
+
+	it("reuses derived blobs for 33 retained tool images across repeated provider turns", async () => {
+		const testStore = createTestStore();
+		const refs: string[] = [];
+		for (let index = 0; index < 33; index++) refs.push(await putSource(testStore.store, await makePng(200 + index)));
+		const messages = toolMessages(refs);
+		const cache = new ToolResultImageCache();
+		const seededPuts = testStore.putCount();
+
+		const first = await normalizeToolResultImagesForProvider(messages, testStore.store, webpCapableModel, cache);
