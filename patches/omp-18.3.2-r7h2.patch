+	}
+
+	#enterTitleOwnershipOverdue(state: TitleOwnershipState): void {
+		if (!this.#isTitleOwnershipCurrent(state) || state.phase !== "timed" || state.suit === "✦") {
+			if (this.#titleOwnership === state) this.#releaseTitleOwnership("session-or-generation-mismatch");
+			return;
+		}
+		state.phase = "overdue";
+		state.waitingForProgress = false;
+		logger.info("title-ownership: reassessment-due", this.#titleOwnershipLogFields(state, "overdue"));
+		void this.#startOverdueTitleReassessment(state);
+	}
+
+	#syncTitleToolResultSequence(): number {
+		for (const message of this.agent.state.messages) {
+			if (message.role !== "toolResult" || this.#titleToolResultIds.has(message.toolCallId)) continue;
+			this.#titleToolResultIds.add(message.toolCallId);
+			this.#titleToolResultSequence++;
+		}
+		return this.#titleToolResultSequence;
+	}
+
+	#hasTitleProgress(state: TitleOwnershipState): boolean {
+		return this.#syncTitleToolResultSequence() > state.progressToolResultSequence;
+	}
+
+	#runOverdueTitleReassessmentAfterProgress(): void {
+		const state = this.#titleOwnership;
+		if (!state || state.phase !== "overdue" || state.run) return;
+		if (!this.#isTitleOwnershipCurrent(state)) {
+			this.#releaseTitleOwnership("session-or-generation-mismatch");
+			return;
+		}
+		if (!this.#hasTitleProgress(state)) {
+			state.waitingForProgress = true;
+			return;
+		}
+		if (state.reassessmentCalls >= 2 || state.reassessmentAttempts >= 2) return;
+		if (state.reassessmentAttempts === 1 && (state.retryAfter === undefined || Date.now() < state.retryAfter)) {
+			state.waitingForProgress = true;
+			return;
+		}
+		state.waitingForProgress = false;
+		void this.#startOverdueTitleReassessment(state);
+	}
+
+	#startOverdueTitleReassessment(state: TitleOwnershipState): Promise<void> {
+		if (state.run) return state.run;
+		const run = this.#runOverdueTitleReassessment(state)
+			.catch(error => {
+				this.#retainOverdueTitleAfterFailure(state, "exception", error);
+			})
+			.finally(() => {
+				if (state.run === run) state.run = undefined;
+			});
+		state.run = run;
+		return run;
+	}
+
+	#retainOverdueTitleAfterFailure(state: TitleOwnershipState, reason: string, error?: unknown): void {
+		if (!this.#isTitleOwnershipCurrent(state) || state.phase !== "overdue") return;
+		state.controller = undefined;
+		state.progressToolResultSequence = this.#syncTitleToolResultSequence();
+		state.waitingForProgress = state.reassessmentCalls < 2 && state.reassessmentAttempts < 2;
+		state.retryAfter = state.waitingForProgress ? Date.now() + OVERDUE_TITLE_RETRY_COOLDOWN_MS : undefined;
+		logger.warn("title-ownership: reassessment-failure", {
+			...this.#titleOwnershipLogFields(state, "reassessment"),
+			reason,
+			retryAfter: state.retryAfter,
+			error: error instanceof Error ? error.message : error === undefined ? undefined : String(error),
+		});
+	}
+
+	async #runOverdueTitleReassessment(state: TitleOwnershipState): Promise<void> {
+		if (!this.#isTitleOwnershipCurrent(state) || state.phase !== "overdue" || state.suit === "✦") return;
+		if (!this.#titleSystemPrompt?.includes("R7_OVERDUE_TITLE_V1")) {
+			state.reassessmentAttempts = 2;
+			this.#retainOverdueTitleAfterFailure(state, "reassessment-unavailable");
+			return;
+		}
+		state.reassessmentAttempts++;
+		state.reassessmentCalls++;
+		const controller = new AbortController();
+		state.controller = controller;
+		const elapsedMinutes = Math.max(1, Math.ceil((Date.now() - state.taskStartedAt) / 60_000));
+		const progress = buildOverdueTitleContext(this.agent.state.messages, state.taskStartedAt);
+		const packet = [
+			"R7_OVERDUE_TITLE_V1",
+			`CURRENT TITLE: ${state.title}`,
+			`ELAPSED MINUTES: ${elapsedMinutes}`,
+			"PROGRESS:",
+			progress || "(No persisted progress messages.)",
+		].join("\n");
+		const result = await generateOverdueTitleReassessment(
+			packet,
+			this.#modelRegistry,
+			this.settings,
+			state.sessionId,
+			provider => this.agent.metadataForProvider(provider),
+			this.#titleSystemPrompt,
+			controller.signal,
+		);
+		if (!this.#isTitleOwnershipCurrent(state) || state.phase !== "overdue") return;
+		if (!result) {
+			this.#retainOverdueTitleAfterFailure(state, "invalid-or-empty");
+			return;
+		}
+		const suit =
+			OVERDUE_TITLE_SUIT_RANK[result.suit] < OVERDUE_TITLE_SUIT_RANK[state.suit] ? state.suit : result.suit;
+		const reassessedAt = Date.now();
+		const projectedTotalMinutes = Math.max(
+			1,
+			Math.round((reassessedAt + result.minutes * 60_000 - state.taskStartedAt) / 60_000),
+		);
+		state.suit = suit;
+		state.title = formatTimedTaskTitle({ suit, minutes: projectedTotalMinutes, title: state.body });
+		state.latestAssistantAt = reassessedAt;
+		state.dueAt = reassessedAt + result.minutes * 60_000 + OVERDUE_TITLE_GRACE_MS;
+		state.phase = "timed";
+		state.progressToolResultSequence = this.#syncTitleToolResultSequence();
+		state.reassessmentAttempts = 0;
+		state.retryAfter = undefined;
+		state.waitingForProgress = false;
+		state.controller = undefined;
+		this.#commitTitleOwnership(state, "reassessment");
+		this.#armTitleOwnershipDeadline(state);
+		logger.info("title-ownership: reassessment-applied", {
+			...this.#titleOwnershipLogFields(state, "reassessment"),
+			elapsedMinutes,
+			reason: result.reason,
+		});
+	}
