@@ -0,0 +1,30 @@
+import { describe, expect, it } from "bun:test";
+import { raceJobSettlement, resolveAutoBackgroundWaitMs } from "@oh-my-pi/pi-coding-agent/async/auto-background";
+
+describe("auto-background wait policy", () => {
+	it("keeps finite timeouts at or below the threshold inline", () => {
+		expect(resolveAutoBackgroundWaitMs(60_000, 30_000)).toBeUndefined();
+		expect(resolveAutoBackgroundWaitMs(60_000, 60_000)).toBeUndefined();
+	});
+
+	it("retains threshold detachment for genuinely longer or unbounded work", () => {
+		expect(resolveAutoBackgroundWaitMs(60_000, 60_001)).toBe(60_000);
+		expect(resolveAutoBackgroundWaitMs(60_000, undefined)).toBe(60_000);
+		expect(resolveAutoBackgroundWaitMs(0, 30_000)).toBe(0);
+	});
+
+	it("settles inline without a threshold timer", async () => {
+		const result = await raceJobSettlement(Promise.resolve({ kind: "completed" as const }), undefined);
+		expect(result).toEqual({ kind: "completed" });
+	});
+
+	it("still yields to steering when threshold detachment is disabled", async () => {
+		const completion = Promise.withResolvers<{ kind: "completed" }>();
+		const steering = new AbortController();
+		const resultPromise = raceJobSettlement(completion.promise, undefined, undefined, steering.signal);
+
+		steering.abort();
+
+		expect(await resultPromise).toEqual({ kind: "steer" });
+	});
+});
diff --git a/packages/coding-agent/test/compaction-history-archive.test.ts b/packages/coding-agent/test/compaction-history-archive.test.ts
new file mode 100644
index 0000000000..f75f6e4056
--- /dev/null
+++ b/packages/coding-agent/test/compaction-history-archive.test.ts
@@ -0,0 +1,122 @@
+import { describe, expect, it } from "bun:test";
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+import {
+	getHistoryArchiveRecord,
+	HISTORY_ARCHIVE_CUSTOM_TYPE,
+	HISTORY_ARCHIVE_PRESERVE_KEY,
+	renderHistoryArchive,
+	writeHistoryArchive,
+} from "@oh-my-pi/pi-coding-agent/session/compaction-history-archive";
+import { buildSessionContext } from "@oh-my-pi/pi-coding-agent/session/session-context";
+import type { SessionEntry } from "@oh-my-pi/pi-coding-agent/session/session-entries";
+
+let nextId = 0;
+function entry(fields: Record<string, unknown>): SessionEntry {
+	nextId += 1;
+	return {
+		id: `e${nextId}`,
+		parentId: nextId === 1 ? null : `e${nextId - 1}`,
+		timestamp: new Date(Date.UTC(2025, 0, 15, 20, 0, nextId)).toISOString(),
+		...fields,
+	} as unknown as SessionEntry;
+}
+
+function sampleBranch(): SessionEntry[] {
+	nextId = 0;
+	return [
+		entry({
+			type: "message",
+			message: {
+				role: "user",
+				content: [{ type: "text", text: "Fix the menu overlay; never touch the config." }],
+				timestamp: 1,
+			},
+		}),
+		entry({
+			type: "message",
+			message: {
+				role: "assistant",
+				content: [
+					{ type: "text", text: "Reading the owner." },
+					{ type: "toolCall", id: "t1", name: "read", arguments: { path: "/repo/src/overlay.py" } },
+					{
+						type: "toolCall",
+						id: "t2",
+						name: "bash",
+						arguments: { command: "python3 -m unittest tests.test_overlay" },
+					},
+					{
+						type: "toolCall",
+						id: "t3",
+						name: "edit",
+						arguments: { input: "*** Begin Patch\n*** Update File: /repo/src/menu.py\n*** End Patch" },
+					},
+				],
+				timestamp: 2,
+			},
+		}),
+		entry({
+			type: "message",
+			message: {
+				role: "toolResult",
+				toolCallId: "t2",
+				toolName: "bash",
+				content: [{ type: "text", text: "Ran 6 tests\n```\nOK" }],
+				isError: false,
+				timestamp: 3,
+			},
+		}),
+		entry({
+			type: "message",
+			message: { role: "user", content: [{ type: "text", text: "now make it remember the last tab" }], timestamp: 4 },
+		}),
+	];
+}
+
+describe("compacted history archive", () => {
+	it("indexes asks, files and commands and keeps the transcript verbatim", () => {
+		const { markdown, turns } = renderHistoryArchive(sampleBranch(), "/sessions/chat.jsonl");
+		expect(turns).toBe(2);
+		expect(markdown).toContain("- T1 (");
+		expect(markdown).toContain("Fix the menu overlay; never touch the config.");
+		expect(markdown).toContain("- /repo/src/menu.py");
+		expect(markdown).toContain("- /repo/src/overlay.py");
+		expect(markdown).toContain("`python3 -m unittest tests.test_overlay`");
+		expect(markdown).toContain("### T2 — ");
+		// A result containing a triple backtick gets a longer fence.
+		expect(markdown).toContain("````\nRan 6 tests\n```\nOK\n````");
+	});
+
+	it("writes atomically into the artifacts directory and survives a missing directory", () => {
+		const dir = fs.mkdtempSync(path.join(os.tmpdir(), "archive-"));
+		const artifacts = path.join(dir, "session-artifacts");
+		const record = writeHistoryArchive(sampleBranch(), artifacts, "/sessions/chat.jsonl");
+		expect(record?.path).toBe(path.join(artifacts, "compacted-history.md"));
+		expect(fs.readFileSync(record!.path, "utf8")).toContain("# Compacted history");
+		expect(fs.existsSync(`${record!.path}.tmp`)).toBe(false);
+		expect(writeHistoryArchive(sampleBranch(), null, undefined)).toBeUndefined();
+		fs.rmSync(dir, { recursive: true, force: true });
+	});
+
+	it("places a pointer right after the compaction summary in rebuilt context", () => {
+		const branch = sampleBranch();
+		const archivePath = "/sessions/chat/compacted-history.md";
+		const compaction = entry({
+			type: "compaction",
+			summary: "## Goal\nRemember the last tab",
+			firstKeptEntryId: branch[3].id,
+			tokensBefore: 120_000,
+			method: "handoff",
+			preserveData: { [HISTORY_ARCHIVE_PRESERVE_KEY]: { path: archivePath, turns: 2, updatedAt: "x" } },
+		});
+		const context = buildSessionContext([...branch, compaction]);
+		const summaryIndex = context.messages.findIndex(message => message.role === "compactionSummary");
+		const pointer = context.messages[summaryIndex + 1] as { role: string; customType?: string; content?: unknown };
+		expect(pointer.role).toBe("custom");
+		expect(pointer.customType).toBe(HISTORY_ARCHIVE_CUSTOM_TYPE);
+		expect(String(pointer.content)).toContain(archivePath);
+		expect(getHistoryArchiveRecord(undefined)).toBeUndefined();
+	});
+});
diff --git a/packages/coding-agent/test/context-relevance-prune.test.ts b/packages/coding-agent/test/context-relevance-prune.test.ts
new file mode 100644
index 0000000000..a1b3b98e4f
--- /dev/null
+++ b/packages/coding-agent/test/context-relevance-prune.test.ts
@@ -0,0 +1,237 @@
+import { afterAll, afterEach, beforeAll, describe, expect, it } from "bun:test";
+import * as path from "node:path";
+import { Agent, type StreamFn } from "@oh-my-pi/pi-agent-core";
+import type { AssistantMessage, Message } from "@oh-my-pi/pi-ai";
+import { createMockModel } from "@oh-my-pi/pi-ai/providers/mock";
+import { AssistantMessageEventStream } from "@oh-my-pi/pi-ai/utils/event-stream";
+import { ModelRegistry } from "@oh-my-pi/pi-coding-agent/config/model-registry";
+import { Settings } from "@oh-my-pi/pi-coding-agent/config/settings";
+import { AgentSession } from "@oh-my-pi/pi-coding-agent/session/agent-session";
+import { AuthStorage } from "@oh-my-pi/pi-coding-agent/session/auth-storage";
+import {
+	collectLiveUserTurns,
+	parseRelevanceDecision,
+	planRelevancePrune,
+	pruneWorthIt,
+	shouldCheckRelevance,
+} from "@oh-my-pi/pi-coding-agent/session/context-relevance-prune";
+import type { SessionEntry } from "@oh-my-pi/pi-coding-agent/session/session-entries";
+import { convertToLlm } from "@oh-my-pi/pi-coding-agent/session/messages";
+import { SessionManager } from "@oh-my-pi/pi-coding-agent/session/session-manager";
+import { TempDir } from "@oh-my-pi/pi-utils";
+
+const USAGE = {
+	input: 1,
+	output: 1,
+	cacheRead: 0,
+	cacheWrite: 0,
+	totalTokens: 2,
+	cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0, total: 0 },
+};
+const HUGE = "alpha ".repeat(130_000);
+const DECISION = JSON.stringify({
+	switched: true,
+	confidence: 0.95,
+	startTurn: 2,
+	finished: [{ from: 1, to: 1, label: "Menu overlay fix" }],
+	keep: [
+		{ source: "T1", quote: "never touch the config." },
+		{ source: "T1", quote: "invented instruction" },
+	],
+});
+
+describe("relevance prune rules", () => {
+	it("checks only inside the band and after growth or a cold cache", () => {
+		const base = { hardThresholdTokens: 300_000, cacheCold: false };
+		expect(shouldCheckRelevance({ ...base, contextTokens: 90_000, lastCheckTokens: undefined })).toBe(false);
+		expect(shouldCheckRelevance({ ...base, contextTokens: 120_000, lastCheckTokens: undefined })).toBe(true);
+		expect(shouldCheckRelevance({ ...base, contextTokens: 140_000, lastCheckTokens: 120_000 })).toBe(false);
+		expect(shouldCheckRelevance({ ...base, contextTokens: 150_000, lastCheckTokens: 120_000 })).toBe(true);
+		expect(shouldCheckRelevance({ ...base, contextTokens: 125_000, lastCheckTokens: 120_000, cacheCold: true })).toBe(
+			true,
+		);
+		expect(shouldCheckRelevance({ ...base, contextTokens: 300_000, lastCheckTokens: undefined })).toBe(false);
+	});
+
+	it("cuts a warm cache only for a large share and a cold cache for modest savings", () => {
+		expect(pruneWorthIt(60_000, 200_000, false)).toBe(false);
+		expect(pruneWorthIt(90_000, 200_000, false)).toBe(true);
+		expect(pruneWorthIt(25_000, 120_000, true)).toBe(true);
+		expect(pruneWorthIt(10_000, 120_000, true)).toBe(false);
+	});
+
+	it("rejects unconfident, non-switch and unparseable decisions and invented quotes", () => {
+		const turns = [
+			{ number: 1, entryId: "a", text: "Fix it; never touch the config.", tokens: 100_000, files: [] },
+			{ number: 2, entryId: "b", text: "New level", tokens: 1_000, files: [] },
+		];
+		expect(parseRelevanceDecision("no json")).toBeUndefined();
+		const decision = parseRelevanceDecision(`Sure: ${DECISION}`)!;
+		expect(planRelevancePrune({ ...decision, confidence: 0.5 }, turns, undefined)).toBeUndefined();
+		expect(planRelevancePrune({ ...decision, switched: false }, turns, undefined)).toBeUndefined();
+		expect(planRelevancePrune({ ...decision, startTurn: 1 }, turns, undefined)).toBeUndefined();
+		const plan = planRelevancePrune(decision, turns, undefined)!;
+		expect(plan.firstKeptEntryId).toBe("b");
+		expect(plan.summary).toContain('- T1: "never touch the config."');
+		expect(plan.summary).not.toContain("invented instruction");
+		expect(plan.summary).toContain("- T1: Menu overlay fix");
+	});
+
+	it("numbers live turns after the latest compaction consistently", () => {
+		const entries = [
+			{ type: "message", id: "u1", message: { role: "user", content: "one" } },
+			{ type: "compaction", id: "c1" },
+			{ type: "message", id: "u2", message: { role: "user", content: "two" } },
+			{
+				type: "message",
+				id: "a2",
+				message: { role: "assistant", content: [{ type: "toolCall", arguments: { path: "/x.ts" } }] },
+			},
+		] as unknown as SessionEntry[];
+		const turns = collectLiveUserTurns(entries, () => 10);
+		expect(turns).toEqual([{ number: 2, entryId: "u2", text: "two", tokens: 20, files: ["/x.ts"] }]);
+	});
+});
+
+describe("relevance prune in a real session", () => {
+	let sharedDir: TempDir;
+	let authStorage: AuthStorage;
+	let modelRegistry: ModelRegistry;
+	let tempDir: TempDir;
+	let session: AgentSession | undefined;
+
+	beforeAll(async () => {
+		sharedDir = TempDir.createSync("@pi-prune-shared-");
+		authStorage = await AuthStorage.create(path.join(sharedDir.path(), "auth.db"));
+		authStorage.keys.setRuntime("anthropic", "test-key");
+		modelRegistry = new ModelRegistry(authStorage);
+	});
+	afterAll(async () => {
+		authStorage.close();
+		await sharedDir.remove().catch(() => {});
+	});
+	afterEach(async () => {
+		await session?.dispose();
+		session = undefined;
+		await tempDir?.remove().catch(() => {});
+	});
+
+	function build(lastReplyAgeMs: number) {
+		tempDir = TempDir.createSync("@pi-prune-");
+		const sessionManager = SessionManager.create(tempDir.path(), tempDir.path());
+		const mock = createMockModel({
+			id: "claude-test",
+			provider: "anthropic",
+			contextWindow: 1_000_000,
+			responses: [{ content: ["first"] }, { content: ["second"] }],
+		});
+		const reply = (content: AssistantMessage["content"], age: number) =>
+			({
+				role: "assistant",
+				content,
+				api: mock.api,
+				provider: mock.provider,
+				model: mock.id,
+				stopReason: "stop",
+				usage: USAGE,
+				timestamp: Date.now() - age,
+			}) as AssistantMessage;
+		// Realistic shape: the bulk is a tool result; the final reply is short.
+		const seed: Message[] = [
+			{
+				role: "user",
+				content: [{ type: "text", text: "Fix the menu overlay; never touch the config." }],
+				timestamp: Date.now() - lastReplyAgeMs - 3,
+			},
+			reply([{ type: "toolCall", id: "t1", name: "read", arguments: { path: "/x.py" } }], lastReplyAgeMs + 2),
+			{
+				role: "toolResult",
+				toolCallId: "t1",
+				toolName: "read",
+				content: [{ type: "text", text: HUGE }],
+				isError: false,
+				timestamp: Date.now() - lastReplyAgeMs - 1,
+			} as Message,
+			reply([{ type: "text", text: "Fixed." }], lastReplyAgeMs),
+		];
+		for (const message of seed) sessionManager.appendMessage(message);
+		let sideCalls = 0;
+		const sideStreamFn: StreamFn = requestModel => {
+			sideCalls += 1;
+			const stream = new AssistantMessageEventStream();
+			queueMicrotask(() => {
+				stream.push({
+					type: "done",
+					reason: "stop",
+					message: {
+						role: "assistant",
+						content: [{ type: "text", text: DECISION }],
+						api: requestModel.api,
+						provider: requestModel.provider,
+						model: requestModel.id,
+						stopReason: "stop",
+						usage: USAGE,
+						timestamp: Date.now(),
+					},
+				});
+			});
+			return stream;
+		};
+		session = new AgentSession({
+			agent: new Agent({
+				getApiKey: () => "test-key",
+				initialState: { model: mock, systemPrompt: ["Test"], tools: [], messages: [...seed] },
+				streamFn: mock.stream,
+				convertToLlm,
+			}),
+			sessionManager,
+			settings: Settings.isolated({
+				"compaction.enabled": true,
+				"compaction.autoContinue": false,
+				"compaction.asyncEnabled": false,
+				"compaction.idleEnabled": false,
+				"compaction.thresholdPercent": 85,
+				"compaction.thresholdTokens": 300_000,
+				"contextPromotion.enabled": false,
+			}),
+			modelRegistry,
+			sideStreamFn,
+		});
+		return { mock, sessionManager, sideCalls: () => sideCalls };
+	}
+
+	const requestText = (call: { context: { messages: unknown[] } }) => JSON.stringify(call.context.messages);
+
+	it("cuts a finished task before the first request when the cache is cold", async () => {
+		const { mock, sessionManager, sideCalls } = build(10 * 60 * 1000);
+		await session!.prompt("Design a new cave level layout.");
+
+		expect(sideCalls()).toBe(1);
+		const compaction = sessionManager.getBranch().find(entry => entry.type === "compaction");
+		expect(compaction).toMatchObject({ details: { kind: "relevance-prune", startTurn: 2 } });
+		expect(mock.calls).toHaveLength(1);
+		const sent = requestText(mock.calls[0]);
+		expect(sent).not.toContain("alpha alpha alpha");
+		expect(sent).toContain("never touch the config.");
+		expect(sent).toContain("compacted-history.md");
+		expect(sent).toContain("Design a new cave level layout.");
+	});
+
+	it("checks in the background on a warm cache and applies at the next message", async () => {
+		const { mock, sessionManager, sideCalls } = build(10_000);
+		await session!.prompt("Design a new cave level layout.");
+		expect(requestText(mock.calls[0])).toContain("alpha alpha alpha");
+		await Bun.sleep(10);
+		await session!.prompt("Add a second exit.");
+
+		expect(sideCalls()).toBe(1);
+		const compaction = sessionManager.getBranch().find(entry => entry.type === "compaction");
+		expect(compaction).toMatchObject({ details: { kind: "relevance-prune", startTurn: 2 } });
+		const sent = requestText(mock.calls[1]);
+		expect(sent).not.toContain("alpha alpha alpha");
+		expect(sent).toContain("Design a new cave level layout.");
+		expect(sent).toContain("Add a second exit.");
+		expect(sent).toContain("never touch the config.");
+		expect(sent).toContain("compacted-history.md");
+	});
+});
