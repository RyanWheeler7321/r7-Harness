+					sessionId: pending.sessionId,
+					title: currentTitle,
+					firstLine: this.#boundedTitleOpeningLine(assistantText),
+				});
+				return;
+			}
+			this.#applyR7TitleOwnership(
+				{ suit: "✦", title: "Current task" },
+				"fallback",
+				pending.sessionId,
+				pending.turnGeneration,
+				assistantTimestamp,
+				pending.requestedAt,
+				{
+					firstLine: this.#boundedTitleOpeningLine(assistantText),
+					reason: assistantText.trim() ? "malformed-opening" : "missing-opening",
+				},
+			);
+			return;
+		}
+
+		const state = this.#titleOwnership;
+		if (!state) return;
+		if (!this.#isTitleOwnershipCurrent(state)) {
+			this.#releaseTitleOwnership("session-or-generation-mismatch");
+			return;
+		}
+		if (assistantTimestamp < state.latestAssistantAt) return;
+		let directive = parseTaskTitleDirective(assistantText);
+		// A mid-task revision without a readable time would reset a real forecast.
+		if (!directive || directive.minutesDefaulted) return;
+		if (state.suit !== "✦") {
+			if (directive.suit === "✦") return;
+			if (OVERDUE_TITLE_SUIT_RANK[directive.suit] < OVERDUE_TITLE_SUIT_RANK[state.suit]) {
+				directive = { ...directive, suit: state.suit };
+			}
+		}
+		this.#applyR7TitleOwnership(
+			directive,
+			"revision",
+			state.sessionId,
+			state.generation,
+			assistantTimestamp,
+			state.taskStartedAt,
+		);
+	}
+
+	#armTitleOwnershipDeadline(state: TitleOwnershipState): void {
+		if (!this.#isTitleOwnershipCurrent(state) || state.phase !== "timed" || state.dueAt === undefined) return;
+		if (state.timer) clearTimeout(state.timer);
+		const delay = Math.max(0, state.dueAt - Date.now());
