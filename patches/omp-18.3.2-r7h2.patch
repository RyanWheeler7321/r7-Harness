+/** A title shorter than this yields the row to the full title instead of sharing it with the chip. */
+const MIN_TITLE_WIDTH_BESIDE_STATUS = 12;
+const TITLE_STATUS_GAP = 2;
+
+/**
+ * Live session title rendered immediately above the main composer bar. When the
+ * bar is too narrow for its right group, that group rides on this row's right.
+ */
+export class SessionTitleLine implements Component {
+	constructor(
+		private readonly sessionManager: SessionManager,
+		private readonly relocatedStatus: (width: number) => RelocatedStatusChip | undefined = () => undefined,
+	) {}
