+
+/**
+ * Enforce the task-title display contract after model generation.
+ *
+ * The main assistant's opening is authoritative for suit and time. The tiny
+ * model supplies only the concise body, so a leaked prefix, duplicated prior
+ * title, wrong suit, or invented time can never change the visible ordering.
+ */
+export function normalizeTaskTitleContract(generatedTitle: string, sourceText: string): string | null {
+	const opening = extractLatestTaskTitleOpening(sourceText);
+	if (!opening) return null;
+
+	const generatedSuitIndex = generatedTitle.search(TASK_TITLE_SUIT_RE);
+	let body = generatedSuitIndex >= 0 ? generatedTitle.slice(generatedSuitIndex + 1) : generatedTitle;
+	body = body
+		.replace(/^\s*\|\s*/, "")
+		.replace(/^\d+m\s*\|\s*/i, "")
+		.trim();
+
+	if (!body || body.includes("|") || TASK_TITLE_SUIT_RE.test(body) || !PRINTABLE_ASCII_RE.test(body)) {
+		body = opening.title;
+	}
+
+	const prefix = opening.minutes ? `${opening.suit} | ${opening.minutes} | ` : `${opening.suit} | `;
+	if (prefix.length + body.length > 80) body = opening.title;
+	if (!body || !PRINTABLE_ASCII_RE.test(body) || prefix.length + body.length > 80) return null;
+	return `${prefix}${body}`;
+}
+
+function extractLatestTaskTitleOpening(
+	sourceText: string,
+): { suit: "✦" | "♥" | "♦" | "♠"; minutes?: string; title: string } | null {
+	const matches: Array<{
+		index: number;
+		suit: "✦" | "♥" | "♦" | "♠";
+		minutes?: string;
+		title: string;
+	}> = [];
+
+	TASK_TITLE_TIMED_OPENING_RE.lastIndex = 0;
+	for (const match of sourceText.matchAll(TASK_TITLE_TIMED_OPENING_RE)) {
+		matches.push({
+			index: match.index,
+			suit: match[1] as "♥" | "♦" | "♠",
+			minutes: match[3],
+			title: match[2]?.trim() ?? "",
+		});
+	}
+	TASK_TITLE_QUICK_OPENING_RE.lastIndex = 0;
+	for (const match of sourceText.matchAll(TASK_TITLE_QUICK_OPENING_RE)) {
+		matches.push({
+			index: match.index,
+			suit: "✦",
+			title: match[2]?.trim() ?? "",
+		});
+	}
+
+	const latest = matches.sort((left, right) => right.index - left.index)[0];
+	if (!latest?.title || !PRINTABLE_ASCII_RE.test(latest.title)) return null;
+	return { suit: latest.suit, minutes: latest.minutes, title: latest.title };
+}
