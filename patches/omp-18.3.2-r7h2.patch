+/**
+ * Provider of the process's main (top-level) session model, read lazily so a
+ * mid-session model switch is seen by the next lookup. Subagent sessions never
+ * register, so helpers follow the main session rather than steering it.
+ */
+let mainModelProviderSource: (() => string | undefined) | undefined;
+
+export function setMainModelProviderSource(source: (() => string | undefined) | undefined): void {
+	mainModelProviderSource = source;
+}
+
+export function getMainModelProvider(): string | undefined {
+	return mainModelProviderSource?.();
+}
