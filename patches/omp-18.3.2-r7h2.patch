+/** Conservative positive classifier for Bash calls that cannot mutate state. */
+export function bashCommandIsReadOnly(raw: unknown): boolean {
+	if (typeof raw !== "string") return false;
+	let command = raw.trim();
+	if (!command || /[\n\r;&|<>`]|\$\(/.test(command)) return false;
+
+	const rtk = /^(?:\S*\/)?rtk\s+/.exec(command);
+	if (rtk) command = command.slice(rtk[0].length);
+
+	if (/^find\b/.test(command)) {
+		return !/(?:^|\s)-(?:delete|exec|execdir|ok|okdir|fprint0?|fls|fprintf)(?:\s|$)/.test(command);
+	}
+	if (/^rg\b/.test(command)) {
+		return !/(?:^|\s)--pre(?:[=\s]|$)/.test(command);
+	}
+	if (/^git(?:\s+-C\s+\S+)?\s+(?:status|diff|show|log|rev-parse)\b/.test(command)) {
+		return !/(?:^|\s)(?:--output(?:[=\s]|$)|--ext-diff(?:\s|$)|--textconv(?:\s|$))/.test(command);
+	}
+	return (
+		/^(?:grep|ls|cat|head|tail|wc|pwd|stat|file|realpath|readlink|which)\b/.test(command) ||
+		/^command\s+-v\b/.test(command)
+	);
+}
