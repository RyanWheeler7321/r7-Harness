diff --git a/packages/coding-agent/test/main-model-provider-roles.test.ts b/packages/coding-agent/test/main-model-provider-roles.test.ts
new file mode 100644
index 0000000000..493f2515f7
--- /dev/null
+++ b/packages/coding-agent/test/main-model-provider-roles.test.ts
@@ -0,0 +1,71 @@
+import { afterEach, describe, expect, it } from "bun:test";
+import { setMainModelProviderSource } from "@oh-my-pi/pi-coding-agent/config/main-model-provider";
+import { ModelRegistry } from "@oh-my-pi/pi-coding-agent/config/model-registry";
+import { resolveRoleChain } from "@oh-my-pi/pi-coding-agent/config/model-resolver";
+import { roleCandidatePool } from "@oh-my-pi/pi-coding-agent/config/model-roles";
+import { Settings } from "@oh-my-pi/pi-coding-agent/config/settings";
+import { createInMemoryAuthStorage } from "./helpers/agent-session-setup";
+
+afterEach(() => {
+	setMainModelProviderSource(undefined);
+});
+
+function roleSettings(): Settings {
+	return Settings.isolated({
+		modelRoles: {
+			smol: "openai-codex/gpt-6-luna:medium",
+			task: "openai-codex/gpt-6-sol:high",
+			Opus: "anthropic/claude-opus-5-5:high",
+		},
+		modelRolesByProvider: {
+			anthropic: {
+				smol: "anthropic/claude-sonnet-5:medium",
+				task: "anthropic/claude-opus-5-5:high",
+			},
+		},
+	});
+}
+
+describe("provider-scoped model roles", () => {
+	it("follows the main session's current provider at lookup time", () => {
+		const settings = roleSettings();
+		let provider: string | undefined = "anthropic";
+		setMainModelProviderSource(() => provider);
+		expect(settings.getModelRole("smol")).toBe("anthropic/claude-sonnet-5:medium");
+		expect(settings.getModelRole("task")).toBe("anthropic/claude-opus-5-5:high");
+
+		provider = "openai-codex";
+		expect(settings.getModelRole("smol")).toBe("openai-codex/gpt-6-luna:medium");
+		expect(settings.getModelRole("task")).toBe("openai-codex/gpt-6-sol:high");
+	});
+
+	it("keeps base roles for unlisted roles and without a main session", () => {
+		const settings = roleSettings();
+		expect(settings.getModelRole("smol")).toBe("openai-codex/gpt-6-luna:medium");
+		setMainModelProviderSource(() => "anthropic");
+		expect(settings.getModelRole("Opus")).toBe("anthropic/claude-opus-5-5:high");
+		expect(settings.getModelRoles().smol).toBe("openai-codex/gpt-6-luna:medium");
+	});
+});
+
+describe("web search follows the main provider", () => {
+	it("puts the provider-scoped web role first and keeps the base chain as fallback", () => {
+		const authStorage = createInMemoryAuthStorage();
+		authStorage.keys.setRuntime("anthropic", "test-anthropic-key");
+		authStorage.keys.setRuntime("openai-codex", "test-codex-key");
+		const settings = Settings.isolated({
+			modelRoles: { web: "openai-codex/gpt-5.6-luna" },
+			modelRolesByProvider: { anthropic: { web: "anthropic/claude-haiku-4-5" } },
+			retry: { fallbackChains: { web: ["openai-codex/gpt-5.6-luna", "anthropic/claude-haiku-4-5"] } },
+		});
+		const pool = roleCandidatePool("web", settings, new ModelRegistry(authStorage, undefined, { settings }));
+		const chain = () => resolveRoleChain("web", settings, pool).map(candidate => candidate.model.provider);
+		try {
+			expect(chain().slice(0, 2)).toEqual(["openai-codex", "anthropic"]);
+			setMainModelProviderSource(() => "anthropic");
+			expect(chain().slice(0, 2)).toEqual(["anthropic", "openai-codex"]);
+		} finally {
+			authStorage.close();
+		}
+	});
+});
