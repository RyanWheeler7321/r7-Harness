diff --git a/packages/agent/test/compaction-threshold-ceiling.test.ts b/packages/agent/test/compaction-threshold-ceiling.test.ts
new file mode 100644
index 0000000..7b13279
--- /dev/null
+++ b/packages/agent/test/compaction-threshold-ceiling.test.ts
@@ -0,0 +1,32 @@
+import { describe, expect, it } from "bun:test";
+import type { CompactionSettings } from "@oh-my-pi/pi-agent-core/compaction/compaction";
+import { resolveThresholdTokens, shouldCompact } from "@oh-my-pi/pi-agent-core/compaction/compaction";
+
+const settings = (thresholdTokens: number, thresholdPercent = 85): CompactionSettings => ({
+	enabled: true,
+	thresholdPercent,
+	thresholdTokens,
+	keepRecentTokens: 20000,
+});
+
+describe("fixed compaction threshold is a ceiling", () => {
+	it("caps a large window at the fixed limit", () => {
+		expect(resolveThresholdTokens(1_000_000, settings(300_000))).toBe(300_000);
+		expect(shouldCompact(300_001, 1_000_000, settings(300_000))).toBe(true);
+	});
+
+	it("keeps the percentage threshold for a window smaller than the fixed limit", () => {
+		expect(resolveThresholdTokens(272_000, settings(300_000))).toBe(231_200);
+		expect(shouldCompact(250_000, 272_000, settings(300_000))).toBe(true);
+	});
+
+	it("keeps the percentage threshold when no fixed limit is configured", () => {
+		expect(resolveThresholdTokens(1_000_000, settings(-1))).toBe(850_000);
+	});
+
+	it("still caps at the legacy reserve threshold when percent is unset", () => {
+		const threshold = resolveThresholdTokens(272_000, settings(300_000, -1));
+		expect(threshold).toBeLessThan(272_000);
+		expect(threshold).toBe(resolveThresholdTokens(272_000, settings(-1, -1)));
+	});
+});
