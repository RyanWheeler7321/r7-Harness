+import { clearRenderCache, Markdown } from "@oh-my-pi/pi-tui/components/markdown";
+import {
+	DEFAULT_REPLY_PALETTE,
+	REPLY_PALETTE,
+	REPLY_START_MARK,
+	replyStyleEnabled,
+	setReplyStyle,
+	styleReplyText,
+} from "@oh-my-pi/pi-tui/components/reply-style";
+import { getMarkdownTheme, getThemeByName, setThemeInstance } from "@oh-my-pi/pi-tui/theme";
+
+const fg = (hex: string) => `\x1b[38;2;${[1, 3, 5].map(index => parseInt(hex.slice(index, index + 2), 16)).join(";")}m`;
+const plain = (text: string) => text.replace(/\x1b\[[\d;]*m/g, "");
+
+function reply(text: string, width = 72): string[] {
+	clearRenderCache();
+	return [...new Markdown(styleReplyText(text), 1, 0, getMarkdownTheme(), undefined, 0).setReply(true).render(width)];
+}
+
+const SAMPLE = [
+	"## Example title: the result goes here · `~25min`",
+	"",
+	"The Blender side works end to end. **Only the exporter is waiting on you.**",
+	"",
+	"<!-- table: label split rows -->",
+	"| Part | State |",
+	"|---|---|",
+	"| Rig | ✓ working |",
+	"| Check | ▸ running, `~1min` |",
+	"| Save | ✓ working |",
+	"| Exporter | **✗ blocked** |",
+	"",
+	"◆ Costs `$89/yr`, renews `Oct 27`; switch with `Alt+P`.",
+	"+ good point",
+	"− bad point",
+	"○ Build: the rest of the step",
+	"✗ blocked step",
+	"2? A numbered question",
+	"",
+	"“Game Tools”",
+	"− old wording with `code`",
+	"+ new wording",
+	"  continued",
+	"",
+	"▶ Sign in once.",
+].join("\n");
+
+describe("reply style", () => {
+	beforeAll(async () => {
+		setThemeInstance((await getThemeByName("dark"))!);
+	});
+
+	it("colors markers, typed spans, crucial and quoted copy from the fixed palette", () => {
+		const out = reply(SAMPLE).join("\n");
+		expect(out).toContain(`${fg(REPLY_PALETTE.key)}◆`);
+		expect(out).toContain(`${fg(REPLY_PALETTE.result)}▶`);
+		expect(out).toContain(`${fg(REPLY_PALETTE.blocked)}✗`);
+		expect(out).toContain(`${fg(REPLY_PALETTE.plus)}+`);
+		expect(out).toContain(`${fg(REPLY_PALETTE.minus)}−`);
+		expect(out).toContain(`${fg(REPLY_PALETTE.ask)}2?`);
+		expect(out).toContain(`${fg(REPLY_PALETTE.money)}$89/yr`);
+		expect(out).toContain(`${fg(REPLY_PALETTE.date)}Oct 27`);
+		expect(out).toContain(`${fg(REPLY_PALETTE.code)}Alt+P`);
+		expect(out).toContain(`${fg(REPLY_PALETTE.crucial)}Only the exporter is waiting on you.`);
+		expect(out).toContain(`${fg(REPLY_PALETTE.stepLabel)}Build:`);
+		expect(out).toContain(`${fg(REPLY_PALETTE.label)}\x1b[1mGame Tools`);
+		expect(out).toContain(`${fg(REPLY_PALETTE.oldText)} old wording with code`);
+		expect(out).toContain(`${fg(REPLY_PALETTE.newText)} new wording`);
+		expect(out).toContain(`${fg(REPLY_PALETTE.newText)}  continued`);
+		// Pros and cons outside a “Place” group keep plain text after the marker.
+		expect(out).not.toContain(`${fg(REPLY_PALETTE.newText)} good point`);
+		expect(plain(out)).not.toContain("<!--");
+		expect(plain(out)).not.toContain("|");
+	});
+
+	it("dates cover months and years, and red swallows spans inside it", () => {
+		const out = reply("Start in `January`, land it in `2027`, by `March 2027`.\n\n**Apply by `Oct 27`.**").join("\n");
+		expect(out).toContain(`${fg(REPLY_PALETTE.date)}January`);
+		expect(out).toContain(`${fg(REPLY_PALETTE.date)}2027`);
+		expect(out).toContain(`${fg(REPLY_PALETTE.date)}March 2027`);
+		expect(out).toContain(`${fg(REPLY_PALETTE.crucial)}Apply by Oct 27.`);
+		expect(reply("A `Marker` and a `Decoder`.").join("\n")).not.toContain(fg(REPLY_PALETTE.date));
+	});
+
+	it("keeps titles bold, not red, and returns to the title color after a time", () => {
+		const [title] = reply("## A **bold** title with `~25min` left");
+		expect(title).toContain(`${fg(REPLY_PALETTE.time)}~25min`);
+		expect(title).not.toContain(fg(REPLY_PALETTE.crucial));
+		const headingPrefix = getMarkdownTheme().heading(getMarkdownTheme().bold("\x00")).split("\x00")[0];
+		expect(title).toContain(`~25min\x1b[39m${headingPrefix} left`);
+	});
+
+	it("paints an option title's OPTION lead bold white and keeps the rest in the title color", () => {
+		const [title] = reply("## OPTION 2: Rebuild on Twitch's design");
+		const headingPrefix = getMarkdownTheme().heading(getMarkdownTheme().bold("\x00")).split("\x00")[0];
+		expect(title).toContain(`${fg(REPLY_PALETTE.option)}\x1b[1mOPTION 2:\x1b[22m\x1b[39m${headingPrefix} Rebuild`);
+		expect(plain(title)).toContain("OPTION 2: Rebuild on Twitch's design");
+		expect(plain(reply("## Option two, not a lead")[0])).toContain("Option two");
+		expect(reply("## Option two, not a lead")[0]).not.toContain(fg(REPLY_PALETTE.option));
+	});
+
+	it("leaves ordinary markdown untouched when reply mode is off", () => {
+		clearRenderCache();
+		const out = new Markdown("**bold** `code` | a |\n\n◆ x", 1, 0, getMarkdownTheme(), undefined, 0)
+			.render(60)
+			.join("\n");
+		expect(out).not.toContain(fg(REPLY_PALETTE.crucial));
+		expect(out).not.toContain(fg(REPLY_PALETTE.code));
+		expect(out).not.toContain(fg(REPLY_PALETTE.key));
+	});
+
+	it("draws the start line only when marked, across the full width", () => {
+		const lines = reply(`${REPLY_START_MARK}\n\n${SAMPLE}`, 40);
+		expect(plain(lines[0])).toBe("━".repeat(40));
+		expect(plain(reply(SAMPLE, 40)[0])).not.toContain("━");
+	});
+
+	it("wraps a too-wide table's cells in its own borderless style, striped", () => {
+		const long =
+			"| Part | State |\n|---|---|\n| Exporter live run | blocked because the sign-in file inside the virtual machine is missing |\n| Rig | ✓ working |";
+		const lines = reply(long, 40);
+		for (const line of lines) expect(Bun.stringWidth(plain(line))).toBeLessThanOrEqual(40);
+		expect(lines.map(plain).join("\n")).not.toMatch(/[─┌╭]/);
+		expect(lines.filter(line => plain(line).includes("blocked") || plain(line).includes("missing")).length).toBe(2);
+		expect(lines.some(line => line.includes("\x1b[48;2;"))).toBe(true);
+	});
+
+	it("steps tables in a little from the prose edge, the same for stacked tables", () => {
+		const lines = reply(
+			"Some prose.\n\n| A | B |\n|---|---|\n| x | y |\n\n| Longer label | Other |\n|---|---|\n| z | w |",
+			81,
+		).map(plain);
+		const prose = lines.find(line => line.includes("Some"))!.indexOf("S");
+		expect(lines.find(line => line.includes("x"))!.indexOf("x")).toBe(prose + 4);
+		expect(lines.find(line => line.includes("z"))!.indexOf("z")).toBe(prose + 4);
+	});
+
+	it("puts a beside table to the right, and reads a style line above a blank line", () => {
+		const text =
+			"<!-- table: bars -->\n\n| GPU | ms |\n|---|---|\n| Fog | 2.3ms |\n| AO | 0.6ms |\n\n<!-- table: beside -->\n| CPU | ms |\n|---|---|\n| Editor | 8ms |\n| Scripts | 1ms |";
+		const out = reply(text, 100).map(plain);
+		expect(out.some(line => line.includes("Fog") && line.includes("Editor"))).toBe(true);
+		expect(out.join("\n")).toContain("█");
+	});
+
+	it("paints ✓ labels purplish pink and bold, and ○ labels white, never red", () => {
+		const out = reply(
+			"✓ **Rules:** saved\n✓ Renderer: built\n✓ Tests: 9 pass\n\n○ **Jump:** a shortcut\n○ Board: fixed seed",
+		).join("\n");
+		expect(out).toContain(`${fg(REPLY_PALETTE.label)}\x1b[1mRules:`);
+		expect(out).toContain(`${fg(REPLY_PALETTE.label)}\x1b[1mRenderer:`);
+		expect(out).toContain(`${fg(REPLY_PALETTE.label)}\x1b[1mTests:`);
+		expect(out).toContain(`${fg(REPLY_PALETTE.stepLabel)}Jump:`);
+		expect(out).toContain(`${fg(REPLY_PALETTE.stepLabel)}Board:`);
+		expect(out).not.toContain(fg(REPLY_PALETTE.crucial));
+	});
+
+	it("titles a group with a bold label line, and colors time ranges as time", () => {
+		const out = reply(
+			"**Fix plan:**\n○ Cache: the asset scan\n\nImprovement plan:\n○ Skip: the reimport\n\nScan takes `11–55s`, load `28s`\n\n? Main switch, or Subs?",
+		).join("\n");
+		expect(out).toContain(`${fg(REPLY_PALETTE.label)}\x1b[1mFix plan:`);
+		expect(out).toContain(`${fg(REPLY_PALETTE.label)}\x1b[1mImprovement plan:`);
+		expect(out).toContain(`${fg(REPLY_PALETTE.time)}11–55s`);
+		expect(out).toContain(`${fg(REPLY_PALETTE.ask)}?`);
+		expect(out).not.toContain(fg(REPLY_PALETTE.crucial));
+	});
+
+	it("numbers the user's steps in the step color under a label line", () => {
+		const out = reply(
+			"Printer setup:\n1. Close the error box with OK\n2. Tick *Office Printer*, press OK\n\nDriver:\n1. Press `Alt+.`\n2. Add device, pick *Office Printer*",
+		).join("\n");
+		expect(out).toContain(`${fg(REPLY_PALETTE.label)}\x1b[1mPrinter setup:`);
+		expect(out).toContain(`${fg(REPLY_PALETTE.stepNumber)}\x1b[1m1. `);
+		expect(out).toContain(`${fg(REPLY_PALETTE.stepNumber)}\x1b[1m2. `);
+		expect(plain(out).match(/^\s*1\. /gm)?.length).toBe(2);
+	});
+
+	it("gives a marker line's first row the full width", () => {
+		const text = "◆ **Stepping tables in by 4 columns was my call; they could be centered instead.**";
+		const out = reply(text, 81)
+			.map(plain)
+			.filter(line => line.trim());
+		expect(out.length).toBe(1);
+		const long = reply("○ Build: " + "word ".repeat(30), 40)
+			.map(plain)
+			.filter(line => line.trim());
+		expect(Bun.stringWidth(long[0].trimEnd())).toBeGreaterThan(36);
+		for (const line of long.slice(1)) expect(line.startsWith("   ")).toBe(true);
+	});
+
+	it("hangs wrapped marker lines under their text", () => {
+		const out = reply(
+			"○ Own repo: the plugin becomes its own git repo with a fresh first commit in the same folder",
+			40,
+		).map(plain);
+		const rows = out.filter(line => line.trim());
+		expect(rows.length).toBeGreaterThan(1);
+		expect(rows[1].startsWith(" ".repeat(rows[0].indexOf("○") + 2))).toBe(true);
+		expect(rows.every(line => line.length <= 40)).toBe(true);
+		const list = reply("○ Repo: its own repo\n○ Fixes: wording\n○ Site: tool page", 72)
+			.map(plain)
+			.filter(line => line.trim());
+		expect(list.map(line => line.trim().slice(0, 1))).toEqual(["○", "○", "○"]);
+		expect(new Set(list.map(line => line.indexOf("○"))).size).toBe(1);
+	});
+
+	it("keeps red for highlighted text: ✗ is amber", () => {
+		const out = reply("✗ Exporter run: waiting on sign-in").join("\n");
+		expect(out).toContain(`${fg(REPLY_PALETTE.blocked)}✗`);
+		expect(out).not.toContain(fg(REPLY_PALETTE.crucial));
+	});
+
+	it("takes color overrides by cue name and ignores the rest", () => {
+		setReplyStyle({ colors: { crucial: "#00FF00", code: "red", unknown: "#123456" } });
+		try {
+			expect(REPLY_PALETTE.crucial).toBe("#00FF00");
+			expect(REPLY_PALETTE.code).toBe(DEFAULT_REPLY_PALETTE.code);
+			expect(reply("**Watch this.**").join("\n")).toContain(`${fg("#00FF00")}Watch this.`);
+		} finally {
+			setReplyStyle({});
+		}
+		expect(REPLY_PALETTE.crucial).toBe(DEFAULT_REPLY_PALETTE.crucial);
+	});
+
+	it("can be turned off", () => {
+		setReplyStyle({ enabled: false });
+		try {
+			expect(replyStyleEnabled()).toBe(false);
+		} finally {
+			setReplyStyle({});
+		}
+		expect(replyStyleEnabled()).toBe(true);
+	});
+
+	it("streams every frame identical to a full render", () => {
+		const streaming = new Markdown("", 1, 0, getMarkdownTheme(), undefined, 0).setReply(true);
+		streaming.transientRenderCache = true;
+		for (let length = 1; length <= SAMPLE.length; length++) {
+			const text = styleReplyText(SAMPLE.slice(0, length).trim());
+			clearRenderCache();
+			streaming.setText(text);
+			const live = [...streaming.render(60)];
+			clearRenderCache();
+			const oracle = new Markdown(text, 1, 0, getMarkdownTheme(), undefined, 0).setReply(true);
+			oracle.transientRenderCache = true;
+			const cold = [...oracle.render(60)];
+			expect(live).toEqual(cold);
+		}
+	});
+
+	it("keeps rows within the width and cue colors the same in every theme", async () => {
+		const wide = `${SAMPLE}\n\n${"◆ a long line that has to wrap across several rows of the reply ".repeat(3)}`;
+		const dark = reply(wide, 50);
+		for (const line of dark) expect(Bun.stringWidth(plain(line))).toBeLessThanOrEqual(50);
+		setThemeInstance((await getThemeByName("light"))!);
+		const light = reply(wide, 50).join("\n");
+		setThemeInstance((await getThemeByName("dark"))!);
+		for (const key of ["key", "result", "crucial", "money", "date", "code", "label", "newText"] as const) {
+			expect(light).toContain(fg(REPLY_PALETTE[key]));
+		}
+	});
+});
