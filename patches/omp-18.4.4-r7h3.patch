+ * target cannot open. Map drive mounts to `file:///C:/...` and other paths to the
+ * `\\wsl.localhost\<distro>` share. Returns undefined outside WSL.
+ */
+export function windowsHostFileUri(filePath: string, env: NodeJS.ProcessEnv = Bun.env): URL | undefined {
+	const distro = env.WSL_DISTRO_NAME;
