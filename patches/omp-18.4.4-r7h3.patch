+// Reply styling: colored cues for assistant replies, drawn the same in every theme.
+// Only assistant reply text opts in (Markdown.setReply); thinking, tool output and
+// diffs never pass through here. Turned off with the `replyStyle.enabled` setting.
+//
+// styleReplyText() paints the source before Markdown lexes it (raw truecolor escapes
+// pass through the renderer untouched). It works line by line and resets on blank lines,
+// so styling a prefix cut at "\n\n" matches styling the whole text, which keeps
+// Markdown's streaming prefix cache sound. renderReplyTable() replaces the boxed grid.
+import * as fs from "node:fs";
+import { theme } from "../theme/theme";
+import { visibleWidth, wrapTextWithAnsi } from "../utils";
+
+export interface ReplyPalette {
+	money: string;
+	time: string;
+	date: string;
+	plus: string;
+	minus: string;
+	result: string;
+	key: string;
+	ask: string;
+	crucial: string;
+	blocked: string;
+	code: string;
+	label: string;
+	oldText: string;
+	newText: string;
+	stepLabel: string;
+	stepNumber: string;
+	stepRest: string;
+	option: string;
+	start: string;
+}
+
+// Default reply cue colors. Themes change backgrounds and chrome, never these.
+export const DEFAULT_REPLY_PALETTE: Readonly<ReplyPalette> = Object.freeze({
+	money: "#4FE3F0",
+	time: "#6BF5A0",
+	date: "#FF3D9A",
+	plus: "#FF4F8B",
+	minus: "#4FA8FF",
+	result: "#E879F9",
+	key: "#C9A2FF",
+	ask: "#FFC857",
+	crucial: "#FF2E5D",
+	// Red stays for **highlighted** text only; ✗ blocked is amber.
+	blocked: "#FF9A3C",
+	code: "#DD0E9F",
+	// ✓ labels and “Place” lines: purplish pink and bold, well clear of crucial red.
+	label: "#E879F9",
+	oldText: "#BF9BDF",
+	newText: "#3CD6C9",
+	stepLabel: "#FFFFFF",
+	// "1. " numbers on steps the user does themselves.
+	stepNumber: "#FF3D9A",
+	stepRest: "#BF9BDF",
+	// "OPTION 1:" leading an option's title.
+	option: "#FFFFFF",
+	start: "#A4A4B0",
+});
+
+// The live palette: the defaults with the `replyStyle.colors` overrides on top.
+export const REPLY_PALETTE: ReplyPalette = { ...DEFAULT_REPLY_PALETTE };
+
+let replyStyleOn = true;
+
+export function replyStyleEnabled(): boolean {
+	return replyStyleOn;
+}
+
+// Applies the `replyStyle` settings. Unknown keys and values that aren't `#RRGGBB` are ignored.
+export function setReplyStyle(options: { enabled?: boolean; colors?: Readonly<Record<string, unknown>> }): void {
+	replyStyleOn = options.enabled !== false;
+	Object.assign(REPLY_PALETTE, DEFAULT_REPLY_PALETTE);
+	for (const [key, value] of Object.entries(options.colors ?? {})) {
+		if (key in DEFAULT_REPLY_PALETTE && typeof value === "string" && /^#[0-9a-f]{6}$/i.test(value)) {
+			REPLY_PALETTE[key as keyof ReplyPalette] = value;
+		}
+	}
+}
+
+// Marks the reply that follows tool rows; Markdown draws it as the start line.
+export const REPLY_START_MARK = "<!-- reply:start -->";
+// Reply prose stays under ~70 characters; tables step in from the prose edge within it.
+export const REPLY_TEXT_COLUMNS = 72;
+export const REPLY_TABLE_INDENT = 4;
+
+type RGB = [number, number, number];
+const hexRgb = (hex: string): RGB => [1, 3, 5].map(index => parseInt(hex.slice(index, index + 2), 16)) as RGB;
+const mix = (a: RGB, b: RGB, amount: number): RGB =>
+	a.map((value, index) => Math.round(value + (b[index] - value) * amount)) as RGB;
+const fgCode = (rgb: RGB) => `\x1b[38;2;${rgb.join(";")}m`;
+const bgCode = (rgb: RGB) => `\x1b[48;2;${rgb.join(";")}m`;
+const fgHex = (hex: string) => fgCode(hexRgb(hex));
+const paint = (hex: string, text: string, after = "\x1b[39m") => `${fgHex(hex)}${text}${after}`;
+const bold = (text: string) => `\x1b[1m${text}\x1b[22m`;
+const stripAnsi = (text: string) => text.replace(/\x1b\[[\d;]*m/g, "");
+
+const MONTH =
+	"(?:Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|June?|July?|Aug(?:ust)?|Sept?(?:ember)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)\\.?";
+// A code span is recolored only when the whole span is one of these.
+const SPAN_TYPES: [keyof ReplyPalette, RegExp][] = [
+	["money", /^[-+]?\$\d[\d,]*(?:\.\d+)?(?:\/\w+)?$/],
+	[
+		"time",
+		/^~?(?:\d+(?:\.\d+)?(?:\s*[–-]\s*\d+(?:\.\d+)?)?\s*(?:s|sec|secs|seconds?|min|mins|minutes?|h|hrs?|hours?|days?|weeks?|years?)|\d{1,2}:\d{2}(?::\d{2})?\s*\/(?:mi|km)|sub[- ]?\d{1,2}(?::\d{2})?|(?:2[4-9]|[3-9]\d):\d{2}(?::\d{2})?)$/i,
+	],
+	// Dates: "Oct 27", "Oct 27, 2026", "January", "March 2027", "2027", clock times.
+	[
+		"date",
+		new RegExp(
+			`^(?:${MONTH}(?:\\s+\\d{1,2})?(?:,?\\s*\\d{4})?|(?:19|20)\\d{2}|\\d{1,2}:\\d{2}(?::\\d{2})?(?:\\s*[ap]m)?)$`,
+			"i",
+		),
+	],
+];
+const DATE_CELL = SPAN_TYPES[2][1];
+
+// Line-start markers. "3?" numbers a question so the user can answer by number.
+const MARKERS: [keyof ReplyPalette, RegExp][] = [
+	["plus", /^\\?\+(?=\s)/],
+	["minus", /^[−–](?=\s)/],
+	["result", /^[→✓▶](?=\s)/],
+	["blocked", /^✗(?=\s)/],
+	["key", /^◆(?=\s)/],
+	["ask", /^\d*\?(?=\s)/],
+];
+// "○ Build: ..." steps: the short label before the colon stands out, the rest steps back.
+// A bold label ("○ **Build:** ...") counts too, so it never reads as red.
+const STEP = /^(○\s+)(?:\*\*([^*:`\n]{1,24}):\*\*|([^*:`\n]{1,24}):)(\s.*)$/;
+// A short label right after ✓, plain ("Rules:") or bold ("**Rules:**").
+const STATUS_LABEL = /^(\s+)(?:\*\*([^*:`\n]{1,24}):\*\*|([^*:`\n]{1,24}):(?=\s))/;
+// A line that is only "Fix plan:" (or "**Fix plan:**") titles the group under it.
+const GROUP_LABEL = /^(?:\*\*([A-Z][^*:`\n]{0,30}):\*\*|([A-Z][^*:`\n]{0,30}):)\s*$/;
+// A line that is only “Place” labels a group of − current / + new wording pairs.
+const PLACE = /^“([^”\n]+)”\s*$/;
+
+export function styleReplyText(text: string, palette: ReplyPalette = REPLY_PALETTE): string {
+	const stepRest = fgHex(palette.stepRest);
+	// Quoted copy is literal text: backticks inside it would switch colors mid-quote.
+	const pairLine = (hex: string, line: string) => paint(hex, line.replace(/`([^`\n]+)`/g, "$1"));
+	let inCode = false;
+	let inPairs = false;
+	let carry: string | undefined;
+	const out: string[] = [];
+	for (const line of text.split("\n")) {
+		const fence = /^\s*(```|~~~)/.test(line);
+		if (fence) inCode = !inCode;
+		if (inCode || fence || /^#{1,6}\s/.test(line)) {
+			out.push(line);
+			continue;
+		}
+		if (!line.trim()) {
+			inPairs = false;
+			carry = undefined;
+			out.push(line);
+			continue;
+		}
+		if (carry && /^\s{2,}\S/.test(line)) {
+			out.push(pairLine(carry, line));
+			continue;
+		}
+		carry = undefined;
+		const place = PLACE.exec(line);
+		if (place) {
+			inPairs = true;
+			out.push(paint(palette.label, bold(place[1])));
+			continue;
+		}
+		const group = GROUP_LABEL.exec(line);
+		if (group) {
+			out.push(paint(palette.label, bold(`${group[1] ?? group[2]}:`)));
+			continue;
+		}
+		const step = STEP.exec(line);
+		if (step) {
+			out.push(`${step[1]}${paint(palette.stepLabel, `${step[2] ?? step[3]}:`, stepRest)}${step[4]}\x1b[39m`);
+			continue;
+		}
+		const marker = MARKERS.find(([, pattern]) => pattern.test(line));
+		if (!marker) {
+			out.push(line);
+			continue;
+		}
+		const match = marker[1].exec(line)![0];
+		const glyph = paint(palette[marker[0]], match.replace("\\", ""));
+		const rest = line.slice(match.length);
+		if (inPairs && (marker[0] === "plus" || marker[0] === "minus")) {
+			carry = marker[0] === "minus" ? palette.oldText : palette.newText;
+			out.push(glyph + pairLine(carry, rest));
+			continue;
+		}
+		// "✓ Rules: ...": the short label turns purplish pink and bold. A bold label counts too,
+		// so it never reads as red.
+		const label = match === "✓" ? STATUS_LABEL.exec(rest) : null;
+		if (label) {
+			out.push(
+				`${glyph}${label[1]}${paint(palette.label, bold(`${label[2] ?? label[3]}:`))}${rest.slice(label[0].length)}`,
+			);
+			continue;
+		}
+		out.push(glyph + rest);
+	}
+	return out.join("\n");
+}
+
+// A code span in a reply: money, a time or a date gets its type color when the whole
+// span is one; anything else (keys, paths, commands) the fixed code color.
+export function replyCodeSpan(code: string, palette: ReplyPalette = REPLY_PALETTE): string {
+	const type = SPAN_TYPES.find(([, pattern]) => pattern.test(code.trim()));
+	return paint(type ? palette[type[0]] : palette.code, code);
+}
+
+// **crucial**: what the reader must not miss, in red. Headings keep their own bold.
+export function replyCrucial(content: string, palette: ReplyPalette = REPLY_PALETTE): string {
+	// A time or name inside the red phrase takes the red too, so the phrase reads as one.
+	return paint(palette.crucial, content.replace(/\x1b\[(?:38;2;\d+;\d+;\d+|39)m/g, ""));
+}
+
+// "## OPTION 2: Rebuild..." → the "OPTION 2:" lead in bold white; the rest keeps the title color.
+export const OPTION_LEAD = /^(OPTION \d+:)\s*/;
+export function replyOptionLead(lead: string, palette: ReplyPalette = REPLY_PALETTE): string {
+	return paint(palette.option, bold(lead));
+}
+
+export function replyStepNumber(bullet: string, palette: ReplyPalette = REPLY_PALETTE): string {
+	return paint(palette.stepNumber, bold(bullet));
+}
+
+export function replyStartLine(width: number, palette: ReplyPalette = REPLY_PALETTE): string {
+	return paint(palette.start, "━".repeat(Math.max(1, width)));
+}
+
+// ---- r7Shell -------------------------------------------------------------------------
+// r7Shell (R7SHELL_SESSION in the environment) draws reply titles 1.3x and pictures in
+// replies. A private OSC 7321 at the start of a row tells it what the row is; other
+// terminals never get one and show the plain version.
+export const IN_R7SHELL = !!process.env.R7SHELL_SESSION;
+export const R7_TITLE_MARK = "\x1b]7321;title\x07";
+// Sent once at startup so r7Shell knows this is r7Harness (mouse edits, task title row).
+export const R7_HELLO_MARK = "\x1b]7321;hello\x07";
+// Sent when a turn ends.
+export const R7_DONE_MARK = "\x1b]7321;done\x07";
+// Rows kept blank above an image's caption; r7Shell draws the picture over them.
+const R7_IMAGE_ROWS_MAX = 18;
+// A row that stays when blank edges are trimmed.
+export const R7_RESERVED_ROW = "\x1b[0m";
+
+export interface ReplyImage {
+	path: string;
+	rows: number;
+	columns: number;
+}
+
+const imageSizes = new Map<string, { w: number; h: number } | null>();
+
+// Width and height from a PNG, JPEG, GIF or WebP header; null when it isn't one.
+function readImageSize(path: string): { w: number; h: number } | null {
+	if (imageSizes.has(path)) return imageSizes.get(path)!;
+	let size: { w: number; h: number } | null = null;
+	try {
+		const fd = fs.openSync(path, "r");
+		const head = Buffer.alloc(64 * 1024);
+		const n = fs.readSync(fd, head, 0, head.length, 0);
+		fs.closeSync(fd);
+		const b = head.subarray(0, n);
+		if (b.readUInt32BE(0) === 0x89504e47) size = { w: b.readUInt32BE(16), h: b.readUInt32BE(20) };
+		else if (b.toString("ascii", 0, 3) === "GIF") size = { w: b.readUInt16LE(6), h: b.readUInt16LE(8) };
+		else if (b.toString("ascii", 0, 4) === "RIFF" && b.toString("ascii", 8, 12) === "WEBP") {
+			const kind = b.toString("ascii", 12, 16);
+			if (kind === "VP8X") size = { w: 1 + b.readUIntLE(24, 3), h: 1 + b.readUIntLE(27, 3) };
+			else if (kind === "VP8L") {
+				const bits = b.readUInt32LE(21);
+				size = { w: 1 + (bits & 0x3fff), h: 1 + ((bits >> 14) & 0x3fff) };
+			} else if (kind === "VP8 ") size = { w: b.readUInt16LE(26) & 0x3fff, h: b.readUInt16LE(28) & 0x3fff };
+		} else if (b[0] === 0xff && b[1] === 0xd8) {
+			for (let i = 2; i + 9 < b.length;) {
+				if (b[i] !== 0xff) break;
+				const marker = b[i + 1];
+				const len = b.readUInt16BE(i + 2);
+				if (marker >= 0xc0 && marker <= 0xcf && marker !== 0xc4 && marker !== 0xc8 && marker !== 0xcc) {
+					size = { w: b.readUInt16BE(i + 7), h: b.readUInt16BE(i + 5) };
+					break;
+				}
+				i += 2 + len;
+			}
+		}
+	} catch {
+		size = null;
+	}
+	if (size && (!size.w || !size.h)) size = null;
+	imageSizes.set(path, size);
+	return size;
+}
+
+// "C:\x\y.png" or "/mnt/c/x/y.png" or "~/x.png" → a path this process can read.
+function localImagePath(href: string): string {
+	let path = decodeURI(href.trim());
+	if (path.startsWith("file://")) path = path.slice(7);
+	const drive = /^\/?([A-Za-z]):[\\/](.*)$/.exec(path);
+	if (drive) path = `/mnt/${drive[1].toLowerCase()}/${drive[2].replace(/\\/g, "/")}`;
+	if (path.startsWith("~/")) path = `${process.env.HOME ?? ""}${path.slice(1)}`;
+	return path.startsWith("/") ? path : "";
+}
+
+// An image paragraph in a reply: how many rows and columns r7Shell should give it.
+export function replyImage(href: string, width: number): ReplyImage | undefined {
+	if (!IN_R7SHELL) return undefined;
+	const path = localImagePath(href);
+	const size = path ? readImageSize(path) : null;
+	if (!size) return undefined;
+	// r7Shell cells are about 2.25 times as tall as wide.
+	let columns = Math.max(8, Math.min(width, REPLY_TEXT_COLUMNS));
+	let rows = Math.round((columns * size.h) / size.w / 2.25);
+	if (rows > R7_IMAGE_ROWS_MAX) {
+		columns = Math.max(8, Math.round((columns * R7_IMAGE_ROWS_MAX) / rows));
+		rows = R7_IMAGE_ROWS_MAX;
+	}
+	return { path, rows: Math.max(2, rows), columns };
+}
+
+export function r7ImageMark(image: ReplyImage): string {
+	return `\x1b]7321;image;${image.rows};${image.columns};${encodeURIComponent(image.path)}\x07`;
+}
+
+// One optional line right above a table sets its look.
+export function tableDirective(raw: string): string | undefined {
+	return /^\s*<!--\s*table:\s*(.*?)\s*-->\s*$/.exec(raw.trim())?.[1];
+}
+
+function themeRgb(key: string, background = false): RGB {
+	const sample = background ? theme.bg(key as never, "x") : theme.fg(key as never, "x");
+	const match = /\x1b\[(?:38|48);2;(\d+);(\d+);(\d+)m/.exec(sample);
+	return match ? [Number(match[1]), Number(match[2]), Number(match[3])] : [0, 0, 0];
+}
+
+// A whole-cell number with an optional unit: "73%", "42°C", "$21", "~44", "3–10%", "1.5 h".
+const UNIT_SCALE: Record<string, number> = { ms: 0.001, s: 1, min: 60, h: 3600, kb: 1 / 1024, mb: 1, gb: 1024 };
+function cellValue(raw: string): { value: number; unit: string } | undefined {
+	const text = stripAnsi(raw).replace(/[`*]/g, "").trim();
+	// Race times and paces: "28:30", "1:02:15", "9:10/mi".
+	const clock = /^(?:sub[- ]?)?(\d{1,2}):(\d{2})(?::(\d{2}))?\s*(\/mi|\/km)?$/i.exec(text);
+	if (clock) {
+		const [a, b, c] = [clock[1], clock[2], clock[3]].map(Number);
+		return {
+			value: clock[3] ? a * 3600 + b * 60 + c : a * 60 + b,
+			unit: clock[4] ? `pace${clock[4].toLowerCase()}` : "seconds",
+		};
+	}
+	if (!text || DATE_CELL.test(text)) return undefined;
+	const match =
+		/^[~≈<>≤≥]?\s*([-−+]?)([$€£]?)(\d[\d,]*(?:\.\d+)?)(?:\s*[–-]\s*[$€£]?(\d[\d,]*(?:\.\d+)?))?\s*([kMB]?)\s*(%|°C|°F|ms|s|min|h|KB|MB|GB|fps|RPM|W|x|×|\/yr|\/mo)?$/i.exec(
+			text,
+		);
+	if (!match) return undefined;
+	let value = Number(match[3].replace(/,/g, ""));
+	if (match[4]) value = (value + Number(match[4].replace(/,/g, ""))) / 2;
+	if (match[1] === "-" || match[1] === "−") value = -value;
+	value *= { k: 1e3, M: 1e6, B: 1e9 }[match[5] as "k" | "M" | "B"] ?? 1;
+	const unit = (match[2] || match[6] || "").toLowerCase();
+	if (!unit && value >= 1900 && value <= 2100) return undefined;
+	const scale = UNIT_SCALE[unit];
+	const kind = scale ? (["kb", "mb", "gb"].includes(unit) ? "bytes" : "seconds") : unit;
+	return { value: scale ? value * scale : value, unit: kind };
+}
+
+// Borderless tables. Style words, any order, unknown words ignored:
+//   fill   plain | rows | cols | checker | fade | cross | twin | stripes | fadestripes | crossrows
+//          (default: plain up to 3 rows, row stripes from 4)
+//   heat [bg]   color numeric cells by value     +Col / -Col   more is better / worse
+//   shared | each   one value scale per unit or per column
+//   rule label split dim   header rule, colored first column, divider after it, dim header
+//   bars / barsN   proportional bar after the last numeric column
+//   focus   highlight only the last column (the new one)
+//   rowheat [red]   tint whole rows by value (red: black to crucial red)
+//   full | half   stretch to the reply width or half of it
+// Too wide for the reply, the widest text columns narrow and their cells wrap onto more
+// lines; wrapped tables always get row stripes so each row still reads as one.
+export function renderReplyTable(
+	source: string[],
+	style: string,
+	avail: number,
+	inline: (text: string) => string,
+	palette: ReplyPalette = REPLY_PALETTE,
+): string[] {
+	const words = style.split(/[\s,]+/).filter(Boolean);
+	const flags = new Set(words.map(word => word.toLowerCase()));
+	const alignRow = source.find(line => /^\|?\s*:?-{2,}/.test(line.trim()));
+	const rawRows = source
+		.filter(line => line !== alignRow && line.trim())
+		.map(line =>
+			line
+				.trim()
+				.replace(/^\||\|$/g, "")
+				.split("|")
+				.map(cell => cell.trim()),
+		);
+	const count = Math.max(...rawRows.map(row => row.length));
+	const rows = rawRows.map(row => Array.from({ length: count }, (_, index) => inline(row[index] ?? "")));
+	const bodyCount = rows.length - 1;
+	const align = (alignRow ?? "")
+		.trim()
+		.replace(/^\||\|$/g, "")
+		.split("|")
+		.map(cell => cell.trim());
+
+	const fills = [
+		"plain",
+		"rows",
+		"zebra",
+		"cols",
+		"checker",
+		"fade",
+		"cross",
+		"twin",
+		"stripes",
+		"fadestripes",
+		"crossrows",
+	];
+	const chosenFill = fills.find(word => flags.has(word));
+	let fill = chosenFill ?? (bodyCount <= 3 ? "plain" : "rows");
+	if (flags.has("rowheat")) flags.add("heat");
+	const heat = flags.has("heat");
+	const heatBg = (heat && flags.has("bg")) || flags.has("rowheat");
+	const direction = (header: string): number => {
+		const plain = stripAnsi(header).toLowerCase();
+		for (const word of words) {
+			const sign = word[0] === "+" ? 1 : word[0] === "-" ? -1 : 0;
+			if (sign && word.length > 1 && plain.startsWith(word.slice(1).toLowerCase())) return sign;
+		}
+		return 0;
+	};
+
+	// Numeric columns: not the first, at least 80% of filled cells parse, one unit kind.
+	const values = rawRows.slice(1).map(row => Array.from({ length: count }, (_, index) => cellValue(row[index] ?? "")));
+	const numeric = Array.from({ length: count }, (_, index) => {
+		if (index === 0) return undefined;
+		const filled = rawRows
+			.slice(1)
+			.filter(row => (row[index] ?? "").trim() && !/^(—|-|n\/a|\?)$/i.test(row[index].trim()));
+		const parsed = values.map(row => row[index]).filter((value): value is { value: number; unit: string } => !!value);
+		if (!filled.length || parsed.length < Math.ceil(filled.length * 0.8) || parsed.length < 2) return undefined;
+		const units = new Set(parsed.map(item => item.unit));
+		return units.size === 1 ? { unit: parsed[0].unit, list: parsed.map(item => item.value) } : undefined;
+	});
+	const scales = numeric.map(column => {
+		if (!column) return undefined;
+		const pool = flags.has("each")
+			? column.list
+			: numeric.filter(other => other?.unit === column.unit).flatMap(other => other!.list);
+		const min = Math.min(...pool);
+		const max = Math.max(...pool);
+		if (max <= min) return undefined;
+		// Small spreads (41 vs 42°C) shouldn't look like the extremes.
+		const strength = Math.min(1, (max - min) / (0.1 * Math.max(Math.abs(max), 1e-9)));
+		return { min, max, strength };
+	});
+
+	const canvas: RGB = [0, 0, 0];
+	const panel = themeRgb("userMessageBg", true);
+	// The panel color alone is too close to black to separate rows; stripes use a lifted one.
+	const lift = mix(panel, themeRgb("dim"), 0.1);
+	const dim = themeRgb("dim");
+	const text = themeRgb("text");
+	const strong = hexRgb("#FF6FB5");
+	const good = hexRgb(palette.plus);
+	const bad = hexRgb(palette.minus);
+	const heatColor = (rowIndex: number, index: number): RGB | undefined => {
+		const scale = scales[index];
+		const cell = values[rowIndex - 1]?.[index];
+		if (!heat || !scale || !cell) return undefined;
+		const amount = 0.5 + ((cell.value - scale.min) / (scale.max - scale.min) - 0.5) * scale.strength;
+		const sign = direction(rows[0][index]);
+		if (!sign) return amount < 0.5 ? mix(dim, text, amount * 2) : mix(text, strong, (amount - 0.5) * 2);
+		const goodness = sign > 0 ? amount : 1 - amount;
+		return goodness < 0.5 ? mix(bad, text, goodness * 2) : mix(text, good, (goodness - 0.5) * 2);
+	};
+	const lastNumeric = numeric.reduce((last, column, at) => (column ? at : last), -1);
+	const fillAt = (rowIndex: number, index: number): RGB | undefined => {
+		if (rowIndex === 0) return undefined;
+		const bodyRow = rowIndex - 1;
+		const heatIndex = flags.has("rowheat") ? lastNumeric : index;
+		if (heatBg && flags.has("red")) {
+			const scale = scales[heatIndex];
+			const cell = values[bodyRow]?.[heatIndex];
+			if (scale && cell)
+				return mix(canvas, hexRgb(palette.crucial), 0.55 * ((cell.value - scale.min) / (scale.max - scale.min)));
+		}
+		const hot = heatBg ? heatColor(rowIndex, heatIndex) : undefined;
+		if (hot) return mix(canvas, hot, 0.3);
+		if (flags.has("focus")) return index === count - 1 ? lift : undefined;
+		const down = bodyCount > 1 ? bodyRow / (bodyCount - 1) : 0;
+		const odd = bodyRow % 2 === 1;
+		if (fill === "fade") return mix(panel, canvas, bodyCount > 1 ? 0.15 + 0.85 * down : 0);
+		if (fill === "cross") return mix(panel, canvas, index % 2 === 0 ? down : 1 - down);
+		if (fill === "twin") return mix(panel, canvas, index % 2 === 0 ? 0.6 * down : 0.4 + 0.6 * down);
+		// Label column fades down; the rest is striped by row so each line tracks across.
+		if (fill === "stripes") return index === 0 ? mix(lift, canvas, down) : odd ? mix(lift, canvas, 0.35) : undefined;
+		if (fill === "fadestripes") {
+			if (index === 0) return mix(lift, canvas, down);
+			const band = mix(lift, canvas, 0.55 * down);
+			return odd ? band : mix(band, canvas, 0.7);
+		}
+		if (fill === "crossrows") {
+			const base = mix(lift, canvas, index % 2 === 0 ? down : 1 - down);
+			return odd ? mix(base, lift, 0.5) : mix(base, canvas, 0.35);
+		}
+		if (fill === "rows" || fill === "zebra") return odd ? panel : undefined;
+		if (fill === "cols") return index % 2 === 1 ? panel : undefined;
+		if (fill === "checker") return (bodyRow + index) % 2 === 1 ? panel : undefined;
+		return undefined;
+	};
+
+	const widths = Array.from({ length: count }, (_, index) => Math.max(...rows.map(row => visibleWidth(row[index]))));
+	const rightAligned = (index: number) =>
+		(align[index]?.endsWith(":") && !align[index]?.startsWith(":")) ||
+		(!!numeric[index] && !align[index]?.startsWith(":"));
+	const split = flags.has("split");
+	const fillCell = (rgb: RGB | undefined, value: string) =>
+		rgb ? `${bgCode(rgb)}${value.replace(/\x1b\[(?:0|49)m/g, match => `${match}${bgCode(rgb)}`)}\x1b[49m` : value;
+	let barWidth = Number(words.find(word => /^bars\d+$/i.test(word))?.slice(4) ?? 12);
+	if ([...flags].some(flag => /^bars\d+$/.test(flag))) flags.add("bars");
+	const hasBars = flags.has("bars") && lastNumeric >= 0;
+	let total = widths.reduce((sum, width) => sum + width, 0) + 3 * (count - 1) + (hasBars ? barWidth + 1 : 0);
+	// The extra space goes into the bar, or else the first column so numbers stay beside their labels.
+	const target =
+		avail > 0 && flags.has("full") ? avail : avail > 0 && flags.has("half") ? Math.floor((avail - 4) / 2) : 0;
+	const extra = target ? target - 2 - total : 0;
+	if (extra > 0) {
+		if (hasBars) barWidth += extra;
+		else widths[0] += extra;
+		total += extra;
+	}
+	const room = avail > 0 ? avail - 2 : 0;
+	while (room && total > room) {
+		let widest = -1;
+		for (let index = 0; index < count; index++) {
+			if (numeric[index] || widths[index] <= 8) continue;
+			if (widest < 0 || widths[index] > widths[widest]) widest = index;
+		}
+		if (widest < 0) break;
+		widths[widest]--;
+		total--;
+	}
+	const wrapCell = (cell: string, index: number) =>
+		visibleWidth(cell) > widths[index] ? wrapTextWithAnsi(cell, widths[index]) : [cell];
+	const wrapped = rows.some(row => row.some((cell, index) => visibleWidth(cell) > widths[index]));
+	if (wrapped && !chosenFill) fill = "rows";
+	const rowFill = ["rows", "zebra", "fade", "stripes", "fadestripes"].includes(fill);
+	const lines: string[] = [];
+	rows.forEach((row, rowIndex) => {
+		const header = rowIndex === 0;
+		// A blank header row (| | |) is a headerless table: draw nothing for it.
+		if (header && row.every(cell => !stripAnsi(cell).trim())) return;
+		const pieces = row.map((cell, index) =>
+			wrapCell(header || (flags.has("label") && index === 0) ? stripAnsi(cell) : cell, index),
+		);
+		const height = Math.max(...pieces.map(piece => piece.length));
+		for (let part = 0; part < height; part++) {
+			let line = "";
+			for (let index = 0; index < count; index++) {
+				const cell = pieces[index][part] ?? "";
+				const plain = stripAnsi(cell);
+				const space = " ".repeat(Math.max(0, widths[index] - visibleWidth(plain)));
+				const place = (value: string) => (rightAligned(index) ? space + value : value + space);
+				const hot = heatColor(rowIndex, index);
+				let shown: string;
+				if (header) shown = theme.fg(flags.has("dim") ? "dim" : "mdHeading", place(plain));
+				else if (flags.has("label") && index === 0) shown = theme.fg("mdHeading", place(plain));
+				else if (hot && !heatBg) shown = `${fgCode(hot)}${place(plain)}\x1b[39m`;
+				else if (hot) shown = theme.fg("text", place(plain));
+				else shown = place(cell);
+				if (hasBars && index === lastNumeric) {
+					const value = values[rowIndex - 1]?.[index];
+					if (header || part > 0) shown += " ".repeat(barWidth + 1);
+					else {
+						const top = numeric[index]!.unit === "%" ? 100 : Math.max(...numeric[index]!.list);
+						const filled = value ? Math.round((Math.max(0, value.value) / top) * barWidth) : 0;
+						shown += ` ${fgCode(hot ?? themeRgb("accent"))}${"█".repeat(filled)}\x1b[39m${theme.fg("borderMuted", "░".repeat(barWidth - filled))}`;
+					}
+				}
+				const cellFill = fillAt(rowIndex, index);
+				line += fillCell(cellFill, ` ${shown} `);
+				if (index < count - 1) {
+					const divider = index === 0 && split ? theme.fg("borderMuted", "│") : " ";
+					line += fillCell(rowFill && !heatBg ? cellFill : undefined, divider);
+				}
+			}
+			lines.push(line);
+		}
+		if (header && flags.has("rule")) {
+			const rule = split
+				? `${"─".repeat(widths[0] + 2)}┼${"─".repeat(total - widths[0] - 1)}`
+				: "─".repeat(total + 2);
+			lines.push(theme.fg("borderMuted", rule));
+		}
+	});
+	return lines;
+}
