diff --git a/packages/tui/test/terminal-palette.test.ts b/packages/tui/test/terminal-palette.test.ts
new file mode 100644
index 0000000..59014b2
--- /dev/null
+++ b/packages/tui/test/terminal-palette.test.ts
@@ -0,0 +1,84 @@
+import { describe, expect, it } from "bun:test";
+import { TUI, Text } from "@oh-my-pi/pi-tui";
+import { VirtualTerminal } from "./virtual-terminal";
+
+class PaletteTerminal extends VirtualTerminal {
+	background = "";
+	writes = 0;
+	bytes = 0;
+
+	override write(data: string): void {
+		this.writes++;
+		this.bytes += data.length;
+		for (const match of data.matchAll(/\x1b\]11;(#[0-9a-f]{6})\x1b\\/gi)) this.background = match[1]!;
+		super.write(data);
+	}
+}
+
+const idle = { foreground: "#FFFFFF", background: "#070305", cursorColor: "#FFFFFF", selectionBackground: "#E93686" };
+const working = { ...idle, background: "#030A18" };
+
+describe("paint-owned terminal palette", () => {
+	it("repairs a settings-reload reset on the next real paint, unlike one-shot OSC", () => {
+		const terminal = new PaletteTerminal(40, 8);
+		const tui = new TUI(terminal);
+		const text = new Text("working", 0, 0);
+		tui.addChild(text);
+		tui.start();
+		try {
+			terminal.write(`\x1b]11;${working.background}\x1b\\`);
+			terminal.background = idle.background; // Windows Terminal UpdateSettings replaces OSC colors.
+			tui.renderNow();
+			expect(terminal.background).toBe(idle.background); // Reproduces the old failure.
+
+			tui.setTerminalPalette(working);
+			terminal.background = idle.background;
+			text.setText("still working");
+			tui.renderNow();
+			expect(terminal.background).toBe(working.background);
+			expect(terminal.getViewport().some(row => row.includes("still working"))).toBe(true);
+
+			const preview = { ...working, background: "#224466" };
+			tui.setTerminalPalette(preview);
+			terminal.background = idle.background;
+			tui.renderNow();
+			expect(terminal.background).toBe(preview.background);
+			tui.setTerminalPalette(working); // Cancel preview during work.
+			terminal.background = idle.background;
+			tui.renderNow();
+			expect(terminal.background).toBe(working.background);
+			tui.setTerminalPalette(idle); // Real completion.
+			terminal.background = working.background;
+			tui.renderNow();
+			expect(terminal.background).toBe(idle.background);
+		} finally {
+			tui.stop();
+		}
+	});
+
+	it("adds no timer or repaint for a retained palette and rejects escape injection atomically", async () => {
+		const terminal = new PaletteTerminal(40, 8);
+		const tui = new TUI(terminal);
+		tui.addChild(new Text("idle", 0, 0));
+		tui.start();
+		try {
+			tui.setTerminalPalette(working);
+			tui.renderNow();
+			await Bun.sleep(100);
+			const settled = terminal.writes;
+			tui.setTerminalPalette(working);
+			await Bun.sleep(150);
