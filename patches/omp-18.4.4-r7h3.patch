+		private readonly relocatedStatus: (width: number) => RelocatedStatusChip | undefined = () => undefined,
+	) {}
+
+	render(width: number): readonly string[] {
+		// Until the first title arrives, the working folder stands in as the title.
+		const rawTitle = this.sessionManager.getSessionName()?.trim() || path.basename(this.sessionManager.getCwd());
+		const title = rawTitle ? replaceTabs(sanitizeText(rawTitle)).replace(/\s+/g, " ") : "";
+		const styleTitle = (text: string) => ` ${theme.fg("statusLineModel", theme.bold(text))}`;
+		const chip = this.relocatedStatus(width);
+		const chipStart = chip ? width - chip.rightInset - chip.width : -1;
+		if (!chip || chipStart < 0) return title ? [truncateToWidth(styleTitle(title), width)] : [];
+		if (!title) return [" ".repeat(chipStart) + chip.content];
+		// Leading space + title + gap must end before the chip.
+		const titleBudget = chipStart - 1 - TITLE_STATUS_GAP;
+		if (titleBudget < Math.min(MIN_TITLE_WIDTH_BESIDE_STATUS, visibleWidth(title))) {
+			return [truncateToWidth(styleTitle(title), width)];
+		}
+		const lead = styleTitle(truncateToWidth(title, titleBudget));
+		return [lead + " ".repeat(Math.max(0, chipStart - visibleWidth(lead))) + chip.content];
+	}
