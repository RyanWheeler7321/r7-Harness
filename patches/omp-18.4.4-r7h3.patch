+/**
+ * Relevance pruning: when the live context is between the prune floor and the
+ * hard compaction threshold and the user's task has fundamentally changed, drop the
+ * finished earlier work instead of summarizing it.
+ *
+ * A small role model reads only a compact turn index (not the conversation) in
+ * the background. The cut itself is local: everything before the current task's
+ * first message becomes a short block of verbatim standing instructions and
+ * one-line labels, committed as an ordinary compaction entry. The readable
+ * compacted-history archive keeps every removed detail recoverable.
+ */
+
+import type { AgentMessage } from "@oh-my-pi/pi-agent-core";
+import type { AssistantMessage, Context } from "@oh-my-pi/pi-ai";
+import type { SessionEntry } from "./session-entries";
+
+/** Below this, context is cheap enough that checking is not worth a call. */
+export const PRUNE_MIN_CONTEXT_TOKENS = 100_000;
+/** Context growth required before another check. */
+export const PRUNE_CHECK_GROWTH_TOKENS = 30_000;
+/** A cut on a warm cache must remove at least this share and amount. */
+export const PRUNE_WARM_MIN_SHARE = 0.4;
+export const PRUNE_WARM_MIN_TOKENS = 50_000;
+/** A cut on a cold cache (provider cache already expired) only needs this much. */
+export const PRUNE_COLD_MIN_TOKENS = 20_000;
+/** Anthropic's default prompt-cache lifetime; after it the full context is rewritten anyway. */
+export const PROMPT_CACHE_COLD_MS = 5 * 60 * 1000;
+/** On a cold cache the pre-prompt path waits this long for a decision, then proceeds unpruned. */
+export const PRUNE_COLD_WAIT_MS = 5_000;
+export const PRUNE_MIN_CONFIDENCE = 0.8;
+
+const ASK_CHARS = 300;
+const SUMMARY_CHARS = 3_000;
+const NEW_MESSAGE_CHARS = 2_000;
+const MAX_QUOTES = 12;
+const MAX_QUOTE_CHARS = 400;
+
+export interface LiveUserTurn {
+	number: number;
+	entryId: string;
+	text: string;
+	tokens: number;
+	files: string[];
+}
+
+export interface PruneDecision {
+	switched: boolean;
+	confidence: number;
+	startTurn: number;
+	finished: { from: number; to: number; label: string }[];
+	keep: { source: string; quote: string }[];
+}
+
+export interface PrunePlan {
+	firstKeptEntryId: string;
+	startTurn: number;
+	summary: string;
+	shortSummary: string;
+}
+
+function textOf(content: unknown): string {
+	if (typeof content === "string") return content;
+	if (!Array.isArray(content)) return "";
+	return content
+		.filter(
+			(block): block is { type: "text"; text: string } => block?.type === "text" && typeof block.text === "string",
+		)
+		.map(block => block.text)
+		.join("\n");
+}
+
+function normalize(text: string): string {
+	return text.replace(/\s+/g, " ").trim();
+}
+
+function isUserMessage(entry: SessionEntry): boolean {
+	if (entry.type !== "message") return false;
+	const message = entry.message as AgentMessage & { role: string; attribution?: string };
+	return message.role === "user" && message.attribution !== "agent";
+}
+
+/**
+ * User messages that are still live (after the latest compaction entry),
+ * each with the approximate tokens of its whole turn. Cutting at one of these
+ * is always safe: the kept range never spans an older compaction entry.
+ */
+export function collectLiveUserTurns(
+	branch: readonly SessionEntry[],
+	countMessage: (message: AgentMessage) => number,
+): LiveUserTurn[] {
+	let liveStart = 0;
+	for (let i = branch.length - 1; i >= 0; i--) {
+		if (branch[i].type === "compaction") {
+			liveStart = i + 1;
+			break;
+		}
+	}
+	let number = 0;
+	for (let i = 0; i < liveStart; i++) if (isUserMessage(branch[i])) number += 1;
+
+	const turns: LiveUserTurn[] = [];
+	for (let i = liveStart; i < branch.length; i++) {
+		const entry = branch[i];
+		if (isUserMessage(entry) && entry.type === "message") {
+			number += 1;
+			turns.push({
+				number,
+				entryId: entry.id,
+				text: textOf((entry.message as { content?: unknown }).content),
+				tokens: 0,
+				files: [],
+			});
+		}
+		const turn = turns.at(-1);
+		if (!turn || entry.type !== "message") continue;
+		turn.tokens += countMessage(entry.message);
+		const content = (entry.message as { role: string; content?: unknown }).content;
+		if (!Array.isArray(content)) continue;
+		for (const block of content as { type?: string; arguments?: Record<string, unknown> }[]) {
+			const filePath = block?.type === "toolCall" ? block.arguments?.path : undefined;
+			if (typeof filePath === "string" && turn.files.length < 6 && !turn.files.includes(filePath)) {
+				turn.files.push(filePath);
+			}
+		}
+	}
+	return turns;
+}
+
+/** Check only when context is in the prune band and has grown since the last check (or the cache went cold). */
+export function shouldCheckRelevance(args: {
+	contextTokens: number;
+	hardThresholdTokens: number;
+	lastCheckTokens: number | undefined;
+	cacheCold: boolean;
+}): boolean {
+	if (args.contextTokens < PRUNE_MIN_CONTEXT_TOKENS || args.contextTokens >= args.hardThresholdTokens) return false;
+	if (args.lastCheckTokens === undefined || args.cacheCold) return true;
+	return args.contextTokens - args.lastCheckTokens >= PRUNE_CHECK_GROWTH_TOKENS;
+}
+
+/** Whether removing `removedTokens` pays back the cache rewrite it causes. */
+export function pruneWorthIt(removedTokens: number, contextTokens: number, cacheCold: boolean): boolean {
+	if (cacheCold) return removedTokens >= PRUNE_COLD_MIN_TOKENS;
+	return removedTokens >= PRUNE_WARM_MIN_TOKENS && removedTokens >= contextTokens * PRUNE_WARM_MIN_SHARE;
+}
+
+export function buildRelevanceRequest(
+	turns: readonly LiveUserTurn[],
+	previousSummary: string | undefined,
+	newMessage: string,
+): Context {
+	const index = turns
+		.map(turn => {
+			const files = turn.files.length ? ` | files: ${turn.files.join(", ")}` : "";
+			return `T${turn.number} [~${Math.round(turn.tokens / 1000)}K tokens]: ${normalize(turn.text).slice(0, ASK_CHARS)}${files}`;
+		})
+		.join("\n");
+	const summary = previousSummary ? normalize(previousSummary).slice(0, SUMMARY_CHARS) : "(none)";
+	const prompt = [
+		"You decide whether earlier conversation can be dropped from an AI coding assistant's context.",
+		"Earlier compacted summary:",
+		summary,
+		"",
+		"Live turns (user messages, oldest first):",
+		index,
+		"",
+		"The user's new message:",
+		normalize(newMessage).slice(0, NEW_MESSAGE_CHARS),
+		"",
+		"Find the turn where the task the user is working on now began (the new message counts as the last turn).",
+		"switched=true only if everything before that turn is finished work the current task does not need at all.",
+		"If the current task builds on, verifies, or refers to earlier turns, answer switched=false. When unsure, switched=false.",
+		"List standing instructions, restrictions or approvals from earlier that still apply, quoted exactly (source is T# or summary).",
+		'Reply with JSON only: {"switched":bool,"confidence":0-1,"startTurn":N,"finished":[{"from":N,"to":N,"label":"short"}],"keep":[{"source":"T#|summary","quote":"exact text"}]}',
+	].join("\n");
+	return { messages: [{ role: "user", content: [{ type: "text", text: prompt }], timestamp: Date.now() }] };
+}
+
+export function parseRelevanceDecision(text: string): PruneDecision | undefined {
+	const match = text.match(/\{[\s\S]*\}/);
+	if (!match) return undefined;
+	let raw: unknown;
+	try {
+		raw = JSON.parse(match[0]);
+	} catch {
+		return undefined;
+	}
+	if (!raw || typeof raw !== "object") return undefined;
+	const value = raw as Record<string, unknown>;
+	if (typeof value.switched !== "boolean" || typeof value.startTurn !== "number") return undefined;
+	const finished = Array.isArray(value.finished)
+		? value.finished.flatMap(item => {
+				const row = item as Record<string, unknown>;
+				return typeof row?.from === "number" && typeof row.to === "number" && typeof row.label === "string"
+					? [{ from: row.from, to: row.to, label: normalize(row.label).slice(0, 160) }]
+					: [];
+			})
+		: [];
+	const keep = Array.isArray(value.keep)
+		? value.keep.flatMap(item => {
+				const row = item as Record<string, unknown>;
+				return typeof row?.source === "string" && typeof row.quote === "string"
+					? [{ source: row.source.trim(), quote: row.quote.trim() }]
+					: [];
+			})
+		: [];
+	return {
+		switched: value.switched,
+		confidence: typeof value.confidence === "number" ? value.confidence : 0,
+		startTurn: Math.trunc(value.startTurn),
+		finished,
+		keep,
+	};
+}
+
+/**
+ * Turn an accepted decision into the compaction block, or undefined when the
+ * decision is not confident, not a switch, or names no safe cut point. Quotes
+ * that are not literally present in their source are discarded.
+ */
+export function planRelevancePrune(
+	decision: PruneDecision,
+	turns: readonly LiveUserTurn[],
+	previousSummary: string | undefined,
+): PrunePlan | undefined {
+	if (!decision.switched || decision.confidence < PRUNE_MIN_CONFIDENCE) return undefined;
+	const startIndex = turns.findIndex(turn => turn.number === decision.startTurn);
+	if (startIndex <= 0) return undefined;
+
+	const byNumber = new Map(turns.map(turn => [`T${turn.number}`, normalize(turn.text)]));
+	const summaryText = previousSummary ? normalize(previousSummary) : "";
+	const quotes: string[] = [];
+	for (const item of decision.keep) {
+		const quote = normalize(item.quote).slice(0, MAX_QUOTE_CHARS);
+		if (!quote) continue;
+		const source = item.source.toUpperCase().startsWith("T") ? byNumber.get(item.source.toUpperCase()) : summaryText;
+		if (!source?.includes(quote)) continue;
+		quotes.push(`- ${item.source}: "${quote}"`);
+		if (quotes.length >= MAX_QUOTES) break;
+	}
+	const finished = decision.finished
+		.filter(item => item.to < decision.startTurn)
+		.map(item => `- T${item.from}${item.to !== item.from ? `–T${item.to}` : ""}: ${item.label}`);
+
+	const summary = [
+		"## Earlier work pruned (task switch)",
+		`The current task starts at user message T${decision.startTurn}. Earlier finished work was removed from live context because this task does not depend on it.`,
+		"",
+		"### Standing instructions from earlier (verbatim)",
+		...(quotes.length ? quotes : ["- none identified beyond the loaded instructions"]),
+		"",
+		"### Finished earlier",
+		...(finished.length ? finished : [`- T1–T${decision.startTurn - 1}: earlier tasks`]),
+	].join("\n");
+	return {
+		firstKeptEntryId: turns[startIndex].entryId,
+		startTurn: decision.startTurn,
+		summary,
+		shortSummary: `Pruned finished work before T${decision.startTurn} (task switch)`,
+	};
+}
+
+export function assistantText(message: AssistantMessage): string {
+	return message.content
+		.filter((block): block is { type: "text"; text: string } => block.type === "text")
+		.map(block => block.text)
+		.join("");
+}
