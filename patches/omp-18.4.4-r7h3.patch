+/**
+ * Readable on-disk record of history that compaction removes from live context.
+ *
+ * Every compaction rewrites one markdown file in the session's artifacts
+ * directory from the complete branch (the JSONL keeps every entry), so the file
+ * is always cumulative and never depends on which compaction method ran. The
+ * rebuilt context carries a short pointer to it; the model greps/reads it when
+ * an earlier detail matters instead of guessing or keeping bulky text live.
+ */
+
+import * as fs from "node:fs";
+import * as path from "node:path";
+import type { AgentMessage } from "@oh-my-pi/pi-agent-core";
+import { logger } from "@oh-my-pi/pi-utils";
+import type { SessionEntry } from "./session-entries";
+
+export const HISTORY_ARCHIVE_PRESERVE_KEY = "historyArchive";
+export const HISTORY_ARCHIVE_FILE_NAME = "compacted-history.md";
+export const HISTORY_ARCHIVE_CUSTOM_TYPE = "compacted-history-archive";
+
+const MAX_TOOL_RESULT_CHARS = 20_000;
+const MAX_TOOL_ARGS_CHARS = 2_000;
+const INDEX_ASK_CHARS = 240;
+
+export interface HistoryArchiveRecord {
+	path: string;
+	turns: number;
+	updatedAt: string;
+}
+
+interface Turn {
+	number: number;
+	timestamp: string;
+	lines: string[];
+	ask: string;
+}
+
+function textOf(content: unknown): string {
+	if (typeof content === "string") return content;
+	if (!Array.isArray(content)) return "";
+	const parts: string[] = [];
+	for (const block of content) {
+		if (!block || typeof block !== "object") continue;
+		const typed = block as { type?: string; text?: string };
+		if (typed.type === "text" && typeof typed.text === "string") parts.push(typed.text);
+		else if (typed.type === "image") parts.push("[image]");
+	}
+	return parts.join("\n");
+}
+
+function clip(text: string, limit: number): string {
+	if (text.length <= limit) return text;
+	const head = Math.floor(limit * 0.7);
+	const tail = limit - head;
+	return `${text.slice(0, head)}\n[... ${text.length - limit} chars omitted; full text is in the session JSONL ...]\n${text.slice(-tail)}`;
+}
+
+function fence(text: string): string {
+	const longestRun = Math.max(2, ...Array.from(text.matchAll(/`+/g), match => match[0].length));
+	const marker = "`".repeat(longestRun + 1);
+	return `${marker}\n${text}\n${marker}`;
+}
+
+function oneLine(text: string, limit: number): string {
+	const flat = text.replace(/\s+/g, " ").trim();
+	return flat.length <= limit ? flat : `${flat.slice(0, limit - 1)}…`;
+}
+
+function stringifyArgs(args: unknown): string {
+	try {
+		return clip(JSON.stringify(args) ?? "", MAX_TOOL_ARGS_CHARS);
+	} catch {
+		return "[unserializable arguments]";
+	}
+}
+
+/** Render the complete branch as a grep-friendly markdown record with a leading index. */
+export function renderHistoryArchive(
+	entries: readonly SessionEntry[],
+	sessionFile: string | undefined,
+): {
+	markdown: string;
+	turns: number;
+} {
+	const turns: Turn[] = [];
+	const files = { read: new Set<string>(), changed: new Set<string>() };
+	const commands: string[] = [];
+	const compactions: string[] = [];
+	let current: Turn | undefined;
+
+	const ensureTurn = (timestamp: string): Turn => {
+		if (current) return current;
+		current = { number: turns.length + 1, timestamp, lines: [], ask: "(continuation)" };
+		turns.push(current);
+		return current;
+	};
+
+	for (const entry of entries) {
+		if (entry.type === "compaction") {
+			compactions.push(
+				`- ${entry.timestamp}: ${entry.method ?? "compaction"}, ${entry.tokensBefore} tokens before (during turn ${turns.length})`,
+			);
+			continue;
+		}
+		if (entry.type === "custom_message") {
+			const text = textOf(entry.content);
+			if (text.trim())
+				ensureTurn(entry.timestamp).lines.push(`**Injected (${entry.customType}):**\n${clip(text, 4000)}`);
+			continue;
+		}
+		if (entry.type !== "message") continue;
+		const message = entry.message as AgentMessage & { role: string };
+		switch (message.role) {
+			case "user": {
+				const text = textOf((message as { content?: unknown }).content);
+				const attribution = (message as { attribution?: string }).attribution;
+				if (attribution === "agent") {
+					if (text.trim()) ensureTurn(entry.timestamp).lines.push(`**System/agent note:**\n${clip(text, 4000)}`);
+					break;
+				}
+				current = {
+					number: turns.length + 1,
+					timestamp: entry.timestamp,
+					lines: [],
+					ask: oneLine(text, INDEX_ASK_CHARS),
+				};
+				turns.push(current);
+				current.lines.push(`**User:**\n${text}`);
+				break;
+			}
+			case "assistant": {
+				const turn = ensureTurn(entry.timestamp);
+				const content = (message as { content?: unknown }).content;
+				if (!Array.isArray(content)) break;
+				for (const block of content) {
+					const typed = block as {
+						type?: string;
+						text?: string;
+						name?: string;
+						arguments?: Record<string, unknown>;
+					};
+					if (typed.type === "text" && typed.text?.trim()) turn.lines.push(`**Assistant:**\n${typed.text}`);
+					if (typed.type !== "toolCall") continue;
+					const args = typed.arguments ?? {};
+					turn.lines.push(`- call \`${typed.name}\` ${stringifyArgs(args)}`);
+					const filePath = typeof args.path === "string" ? args.path : undefined;
+					if (filePath && (typed.name === "read" || typed.name === "grep")) files.read.add(filePath);
+					if (filePath && typed.name === "write") files.changed.add(filePath);
+					if (typed.name === "edit" && typeof args.input === "string") {
+						for (const match of args.input.matchAll(/^\*\*\* (?:Update|Add|Delete) File: (.+)$/gm)) {
+							files.changed.add(match[1].trim());
+						}
+					}
+					if (typed.name === "bash" && typeof args.command === "string") {
+						commands.push(`- T${turn.number}: \`${oneLine(args.command, 200)}\``);
+					}
+				}
+				break;
+			}
+			case "toolResult": {
+				const result = message as { toolName?: string; isError?: boolean; content?: unknown };
+				const text = textOf(result.content);
+				const label = `${result.toolName ?? "tool"} ${result.isError ? "error" : "result"}`;
+				ensureTurn(entry.timestamp).lines.push(`  ${label}:\n${fence(clip(text, MAX_TOOL_RESULT_CHARS))}`);
+				break;
+			}
+			default:
+				break;
+		}
+	}
+
+	const out: string[] = [
+		"# Compacted history",
+		"",
+		"Complete readable record of this chat, rewritten at every compaction. Search it (grep) for exact asks, decisions, paths, commands and outputs instead of guessing.",
+		`Session JSONL (authoritative, unabridged): ${sessionFile ?? "unknown"}`,
+		`Updated: ${new Date().toISOString()}`,
+		"",
+		"## Index",
+		"",
+		"### User messages",
+		...turns
+			.filter(turn => turn.ask !== "(continuation)")
+			.map(turn => `- T${turn.number} (${turn.timestamp}): ${turn.ask}`),
+		"",
+		"### Files changed",
+		...(files.changed.size ? [...files.changed].map(file => `- ${file}`) : ["- none recorded"]),
+		"",
+		"### Files read or searched",
+		...(files.read.size ? [...files.read].map(file => `- ${file}`) : ["- none recorded"]),
+		"",
+		"### Shell commands",
+		...(commands.length ? commands : ["- none recorded"]),
+		"",
+		"### Compactions",
+		...(compactions.length ? compactions : ["- none before this one"]),
+		"",
+		"## Transcript",
+	];
+	for (const turn of turns) {
+		out.push("", `### T${turn.number} — ${turn.timestamp} — ${turn.ask}`, "", ...turn.lines);
+	}
+	return { markdown: `${out.join("\n")}\n`, turns: turns.length };
+}
+
+/**
+ * Rewrite the archive for the given branch. Failures are logged and return
+ * undefined: compaction must still proceed, and the pointer is simply omitted.
+ */
+export function writeHistoryArchive(
+	entries: readonly SessionEntry[],
+	artifactsDir: string | null,
+	sessionFile: string | undefined,
+): HistoryArchiveRecord | undefined {
+	if (!artifactsDir) return undefined;
+	const archivePath = path.join(artifactsDir, HISTORY_ARCHIVE_FILE_NAME);
+	try {
+		const { markdown, turns } = renderHistoryArchive(entries, sessionFile);
+		fs.mkdirSync(artifactsDir, { recursive: true });
+		const temporaryPath = `${archivePath}.tmp`;
+		fs.writeFileSync(temporaryPath, markdown, "utf8");
+		fs.renameSync(temporaryPath, archivePath);
+		logger.info("Compacted history archive written", { path: archivePath, turns, bytes: markdown.length });
+		return { path: archivePath, turns, updatedAt: new Date().toISOString() };
+	} catch (error) {
+		logger.warn("Compacted history archive write failed", {
+			path: archivePath,
+			error: error instanceof Error ? error.message : String(error),
+		});
+		return undefined;
+	}
+}
+
+/** Read the archive record a compaction entry carries, if any. */
+export function getHistoryArchiveRecord(
+	preserveData: Record<string, unknown> | undefined,
+): HistoryArchiveRecord | undefined {
+	const candidate = preserveData?.[HISTORY_ARCHIVE_PRESERVE_KEY];
+	if (!candidate || typeof candidate !== "object") return undefined;
+	const record = candidate as Partial<HistoryArchiveRecord>;
+	if (typeof record.path !== "string" || !record.path) return undefined;
+	return {
+		path: record.path,
+		turns: typeof record.turns === "number" ? record.turns : 0,
+		updatedAt: typeof record.updatedAt === "string" ? record.updatedAt : "",
+	};
+}
+
+/** Context note placed right after the compaction summary. */
+export function renderHistoryArchivePointer(record: HistoryArchiveRecord): string {
+	return [
+		"Earlier conversation was compacted to keep context lean. Its complete readable record is on disk:",
+		`${record.path}`,
+		"It starts with an index (each user message as T#, files changed/read, shell commands, compactions), then the full transcript under `### T#` headings.",
+		"When an exact earlier instruction, decision, path, command or output matters and is not in the summary above, grep or read that file instead of guessing or asking the user to repeat it.",
+	].join("\n");
+}
