+		// A result containing a triple backtick gets a longer fence.
+		expect(markdown).toContain("````\nRan 6 tests\n```\nOK\n````");
+	});
+
+	it("writes atomically into the artifacts directory and survives a missing directory", () => {
+		const dir = fs.mkdtempSync(path.join(os.tmpdir(), "archive-"));
