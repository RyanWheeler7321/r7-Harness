index 0000000..273a304
--- /dev/null
+++ b/packages/coding-agent/test/tool-image-cache.test.ts
@@ -0,0 +1,203 @@
+import { afterEach, beforeEach, describe, expect, it } from "bun:test";
+import type { AgentMessage } from "@oh-my-pi/pi-agent-core";
+import type { Model } from "@oh-my-pi/pi-ai";
+import type { SessionManager } from "@oh-my-pi/pi-coding-agent/session/session-manager";
+import {
+	ToolResultImageCache,
+	normalizeToolResultImagesForProvider,
+} from "@oh-my-pi/pi-coding-agent/session/session-provider-boundary";
+
+const RED_1X1_PNG_BASE64 =
+	"iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAIAAACQd1PeAAAADElEQVR4nGP4z8AAAAMBAQDJ/pLvAAAAAElFTkSuQmCC";
+
+type ToolImageStore = Pick<SessionManager, "putBlob" | "resolveBlobImageData">;
+
+type TestStore = {
+	store: ToolImageStore;
+	blobs: Map<string, string>;
+	putCount(): number;
+};
+
+function createTestStore(): TestStore {
+	const blobs = new Map<string, string>();
+	let puts = 0;
+	const store = {
+		async putBlob(data: Buffer) {
+			puts++;
+			const hash = new Bun.CryptoHasher("sha256").update(data).digest("hex");
+			const ref = `blob:sha256:${hash}`;
+			blobs.set(ref, data.toString("base64"));
+			return { ref };
+		},
+		async resolveBlobImageData(ref: string) {
+			return blobs.get(ref) ?? null;
+		},
+	} as unknown as ToolImageStore;
+	return { store, blobs, putCount: () => puts };
+}
+
+async function putSource(store: ToolImageStore, data: string): Promise<string> {
+	return (await store.putBlob(Buffer.from(data, "base64"))).ref;
+}
+
+async function makePng(width: number): Promise<string> {
+	const bytes = await new Bun.Image(Buffer.from(RED_1X1_PNG_BASE64, "base64"))
+		.resize(width, 200, { filter: "nearest" })
+		.png()
+		.bytes();
+	return Buffer.from(bytes).toString("base64");
+}
+
+async function makeWebP(): Promise<string> {
+	const bytes = await new Bun.Image(Buffer.from(RED_1X1_PNG_BASE64, "base64"))
+		.resize(240, 240, { filter: "nearest" })
+		.webp({ quality: 90 })
+		.bytes();
+	return Buffer.from(bytes).toString("base64");
+}
+
+function toolMessages(refs: readonly string[], mimeType = "image/png"): AgentMessage[] {
+	return refs.map((ref, index) => ({
+		role: "toolResult",
+		toolCallId: `image-${index}`,
+		toolName: "read",
+		content: [{ type: "image", data: ref, mimeType }],
+		isError: false,
+		timestamp: index,
+	}));
+}
+
+function imageAt(messages: AgentMessage[], index = 0) {
+	const message = messages[index];
+	if (!message || message.role !== "toolResult") throw new Error("Expected tool result");
+	const image = message.content[0];
+	if (!image || image.type !== "image") throw new Error("Expected image content");
+	return image;
+}
+
+const webpCapableModel = { provider: "managed-primary", api: "openai-completions" } as Model;
+const stbModel = { ...webpCapableModel, imageInputDecoder: "stb" } as Model;
+const originalNoWebp = Bun.env.OMP_NO_WEBP;
+
+describe("tool-result image blob cache", () => {
+	beforeEach(() => {
+		delete Bun.env.OMP_NO_WEBP;
+	});
+
+	afterEach(() => {
+		if (originalNoWebp === undefined) delete Bun.env.OMP_NO_WEBP;
+		else Bun.env.OMP_NO_WEBP = originalNoWebp;
+	});
+
+	it("reuses derived blobs for 33 retained tool images across repeated provider turns", async () => {
+		const testStore = createTestStore();
+		const refs: string[] = [];
+		for (let index = 0; index < 33; index++) refs.push(await putSource(testStore.store, await makePng(200 + index)));
+		const messages = toolMessages(refs);
+		const cache = new ToolResultImageCache();
+		const seededPuts = testStore.putCount();
+
+		const first = await normalizeToolResultImagesForProvider(messages, testStore.store, webpCapableModel, cache);
+		expect(testStore.putCount() - seededPuts).toBe(33);
+		expect(cache.metadataEntryCount).toBe(33);
+		expect(cache.metadataByteLength).toBeLessThan(8 * 1024);
+		expect(imageAt(first, 0).data).not.toContain("blob:sha256:");
+
+		const second = await normalizeToolResultImagesForProvider(messages, testStore.store, webpCapableModel, cache);
+		expect(testStore.putCount() - seededPuts).toBe(33);
+		expect(imageAt(second, 32).data).not.toContain("blob:sha256:");
+		expect(imageAt(messages, 0).data).toBe(refs[0]);
+	});
+
+	it("reuses 65 retained images, then prunes metadata to the compacted context", async () => {
+		const testStore = createTestStore();
+		const refs: string[] = [];
+		for (let index = 0; index < 65; index++) refs.push(await putSource(testStore.store, await makePng(200 + index)));
+		const messages = toolMessages(refs);
+		const cache = new ToolResultImageCache();
+		const seededPuts = testStore.putCount();
+
+		await normalizeToolResultImagesForProvider(messages, testStore.store, webpCapableModel, cache);
+		await normalizeToolResultImagesForProvider(messages, testStore.store, webpCapableModel, cache);
+		expect(testStore.putCount() - seededPuts).toBe(65);
+		expect(cache.metadataEntryCount).toBe(65);
+
+		await normalizeToolResultImagesForProvider([messages[0]!], testStore.store, webpCapableModel, cache);
+		expect(cache.metadataEntryCount).toBe(1);
+		expect(cache.metadataByteLength).toBeLessThan(256);
+	});
+
+	it("invalidates derived blobs when the model normalization policy changes", async () => {
+		const testStore = createTestStore();
+		const ref = await putSource(testStore.store, await makeWebP());
+		const messages = toolMessages([ref], "image/webp");
+		const cache = new ToolResultImageCache();
+		const seededPuts = testStore.putCount();
+
+		const webp = await normalizeToolResultImagesForProvider(messages, testStore.store, webpCapableModel, cache);
+		expect(imageAt(webp).mimeType).toBe("image/webp");
+		await normalizeToolResultImagesForProvider(messages, testStore.store, webpCapableModel, cache);
+		expect(testStore.putCount() - seededPuts).toBe(1);
+
+		const stb = await normalizeToolResultImagesForProvider(messages, testStore.store, stbModel, cache);
+		expect(imageAt(stb).mimeType).not.toBe("image/webp");
+		expect(testStore.putCount() - seededPuts).toBe(2);
+	});
+
+	it("retries missing original and corrupt derived blobs without mutating authored messages", async () => {
+		const testStore = createTestStore();
+		const source = await makePng(2_000);
+		const sourceRef = await putSource(testStore.store, source);
+		const messages = toolMessages([sourceRef]);
+		const cache = new ToolResultImageCache();
+		const seededPuts = testStore.putCount();
+
+		testStore.blobs.delete(sourceRef);
+		const missing = await normalizeToolResultImagesForProvider(messages, testStore.store, webpCapableModel, cache);
+		const missingMessage = missing[0];
+		if (!missingMessage || missingMessage.role !== "toolResult") throw new Error("Expected tool result");
+		expect(missingMessage.content[0]).toEqual({
+			type: "text",
+			text: "[tool image unavailable: stored blob is missing or invalid]",
+		});
+		expect(cache.metadataEntryCount).toBe(0);
+
+		testStore.blobs.set(sourceRef, source);
+		await normalizeToolResultImagesForProvider(messages, testStore.store, webpCapableModel, cache);
+		const derivedRef = [...testStore.blobs.keys()].find(ref => ref !== sourceRef);
+		expect(derivedRef).toBeDefined();
+		if (!derivedRef) throw new Error("Expected derived blob");
+		const corruptData = Buffer.from("corrupt derived image").toString("base64");
+		testStore.blobs.set(derivedRef, corruptData);
+
+		const retried = await normalizeToolResultImagesForProvider(messages, testStore.store, webpCapableModel, cache);
+		expect(imageAt(retried).data).not.toBe(corruptData);
+		expect(testStore.putCount() - seededPuts).toBe(2);
+		expect(imageAt(messages).data).toBe(sourceRef);
+	});
+
+	it("shares one pending normalization for the same source and policy", async () => {
+		const testStore = createTestStore();
+		const ref = await putSource(testStore.store, await makePng(400));
+		const messages = toolMessages([ref]);
+		const cache = new ToolResultImageCache();
+		const seededPuts = testStore.putCount();
+		const originalResolve = testStore.store.resolveBlobImageData.bind(testStore.store);
+		let release: (() => void) | undefined;
+		const gate = new Promise<void>(resolve => {
+			release = resolve;
+		});
+		testStore.store.resolveBlobImageData = async data => {
+			if (data === ref) await gate;
+			return await originalResolve(data);
+		};
+
+		const first = normalizeToolResultImagesForProvider(messages, testStore.store, webpCapableModel, cache);
+		const second = normalizeToolResultImagesForProvider(messages, testStore.store, webpCapableModel, cache);
+		await Promise.resolve();
+		release?.();
+		await Promise.all([first, second]);
+
+		expect(testStore.putCount() - seededPuts).toBe(1);
+	});
+});
