@@ -0,0 +1,122 @@
+import { describe, expect, it } from "bun:test";
+import * as fs from "node:fs";
+import * as os from "node:os";
+import * as path from "node:path";
+import {
+	getHistoryArchiveRecord,
+	HISTORY_ARCHIVE_CUSTOM_TYPE,
+	HISTORY_ARCHIVE_PRESERVE_KEY,
+	renderHistoryArchive,
+	writeHistoryArchive,
+} from "@oh-my-pi/pi-coding-agent/session/compaction-history-archive";
+import { buildSessionContext } from "@oh-my-pi/pi-coding-agent/session/session-context";
+import type { SessionEntry } from "@oh-my-pi/pi-coding-agent/session/session-entries";
+
+let nextId = 0;
+function entry(fields: Record<string, unknown>): SessionEntry {
+	nextId += 1;
+	return {
+		id: `e${nextId}`,
+		parentId: nextId === 1 ? null : `e${nextId - 1}`,
+		timestamp: new Date(Date.UTC(2026, 8, 24, 20, 0, nextId)).toISOString(),
+		...fields,
+	} as unknown as SessionEntry;
+}
+
+function sampleBranch(): SessionEntry[] {
+	nextId = 0;
+	return [
+		entry({
+			type: "message",
+			message: {
+				role: "user",
+				content: [{ type: "text", text: "Fix the login form; never touch the database." }],
+				timestamp: 1,
+			},
+		}),
+		entry({
+			type: "message",
+			message: {
+				role: "assistant",
+				content: [
+					{ type: "text", text: "Reading the owner." },
+					{ type: "toolCall", id: "t1", name: "read", arguments: { path: "/repo/tools/build_ui.py" } },
+					{
+						type: "toolCall",
+						id: "t2",
+						name: "bash",
+						arguments: { command: "python3 -m unittest tests.test_usage_ui" },
+					},
+					{
+						type: "toolCall",
+						id: "t3",
+						name: "edit",
+						arguments: { input: "*** Begin Patch\n*** Update File: /repo/src/login.ts\n*** End Patch" },
+					},
+				],
+				timestamp: 2,
+			},
+		}),
+		entry({
+			type: "message",
+			message: {
+				role: "toolResult",
+				toolCallId: "t2",
+				toolName: "bash",
+				content: [{ type: "text", text: "Ran 6 tests\n```\nOK" }],
+				isError: false,
+				timestamp: 3,
+			},
+		}),
+		entry({
+			type: "message",
+			message: { role: "user", content: [{ type: "text", text: "now make it renew tokens" }], timestamp: 4 },
+		}),
+	];
+}
+
+describe("compacted history archive", () => {
+	it("indexes asks, files and commands and keeps the transcript verbatim", () => {
+		const { markdown, turns } = renderHistoryArchive(sampleBranch(), "/sessions/chat.jsonl");
+		expect(turns).toBe(2);
+		expect(markdown).toContain("- T1 (");
+		expect(markdown).toContain("Fix the login form; never touch the database.");
+		expect(markdown).toContain("- /repo/src/login.ts");
+		expect(markdown).toContain("- /repo/tools/build_ui.py");
+		expect(markdown).toContain("`python3 -m unittest tests.test_usage_ui`");
